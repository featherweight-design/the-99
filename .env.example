DATABASE_URL=postgresql://user:pass@host/db
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# The model client (src/lib/model/client.ts). Deck tuning and the deck synopsis need it;
# without it the client makes no request, returns a failure and logs "configuration".
ANTHROPIC_API_KEY=
# The owner's Clerk user id (src/lib/model/allowance.ts): that account gets 10 model runs per
# rolling 24 hours and a $5 monthly testing share; everyone else gets 3. Unset or empty, no
# account is the owner and everyone gets 3.
MODEL_OWNER_USER_ID=
# Deck notices (src/lib/notices/flag.ts): 'true' shows them; anything else hides every notices
# surface. On in staging, off in production until the feature is walked. The ingests write the
# change log either way.
NOTICES_ENABLED=
# The swap tools (src/lib/swaps/flag.ts): the Shopping limit, cheaper stand-ins and Fits your
# decks. Off for anything but 'true'. On in staging, off in production until Hugh walks it.
SWAP_TOOLS_ENABLED=
