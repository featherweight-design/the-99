DATABASE_URL=postgresql://user:pass@host/db
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Signing secret of the Clerk webhook endpoint (/api/clerk-webhook, user.deleted). Verifies the Svix signature.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# The model client (src/lib/model/client.ts). Deck tuning and the deck synopsis need it;
# without it the client makes no request, returns a failure and logs "configuration".
ANTHROPIC_API_KEY=
# The owner's Clerk user id (src/lib/model/allowance.ts): that account gets 10 model runs per
# rolling 24 hours and a $5 monthly testing share; everyone else gets 3. Unset or empty, no
# account is the owner and everyone gets 3.
MODEL_OWNER_USER_ID=
# The admin (/admin): both required, or there is no admin at all. Comma-separated Clerk ids.
ADMIN_USER_IDS=
# staging or production: which database this admin changes. Anything else means no admin.
ADMIN_ENV_LABEL=
# STAGING_CRONS=   # 'run' runs the Vercel crons where ADMIN_ENV_LABEL=staging (src/lib/cron/staging-pause.ts)
# The swap tools (src/lib/swaps/flag.ts): the Shopping limit, cheaper stand-ins and Fits your
# decks. Off for anything but 'true'. On in staging, off in production until Hugh walks it.
SWAP_TOOLS_ENABLED=
# The list cache (src/lib/cache/list-cache-flag.ts): Home and /decks cached per reader on the
# data stamp. Off for anything but 'true', and off means the pages run uncached exactly as before.
# On in staging, off in production until Hugh has watched it there.
LIST_CACHE_ENABLED=
# The stuck-loader diagnostic: logs a [nav-stall] line when a loading screen stays up 8s (plumbing).
NAV_STALL_LOG_ENABLED=
RATE_LIMIT_ENABLED=
# Help me choose (src/lib/intake/flag.ts): the /decks/new/choose route and both doors.
# Off for anything but 'true'. On in staging, off in production until Hugh walks it.
HELP_ME_CHOOSE_ENABLED=
# Suggested changes (src/lib/tuning/flag.ts): needs 'true' AND ANALYSIS_TAB_ENABLED 'true'.
# Off, the bracket and the Overview still draw on the Analysis tab (decoupled 2026-10-08).
TUNING_ENABLED=
# Proposed cuts, the model pass (src/lib/tuning/flag.ts): needs 'true' AND ANALYSIS_TAB_ENABLED 'true'.
# Independent of TUNING_ENABLED. Off for anything but 'true'; off in production until Hugh walks it.
PROPOSED_CUTS_ENABLED=
# Evidence benchmarks (src/lib/decks/benchmarks-flag.ts): 'true' grades a reading on the Analysis tab
# (inert until the block ships, plan PR 3).
# Off for anything but 'true': nothing is read or drawn.
DECK_BENCHMARKS_ENABLED=

# Stripe (payments). TEST MODE everywhere but production: the server refuses a live key unless
# ADMIN_ENV_LABEL=production, and a test key when it is (src/lib/payments/key-mode.ts).
# A RESTRICTED key (rk_test_...): Checkout Sessions and Customers write; Charges, PaymentIntents and Events read.
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe-webhook endpoint (whsec_...), per endpoint and per mode.
STRIPE_WEBHOOK_SECRET=
# The previous signing secret, set only while a roll overlaps, then cleared.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
# The Price id of the 40-credit pack ($5) in this mode (price_...). Its tax behavior MUST be exclusive:
# the webhook grants only when the total less tax is $5.00.
STRIPE_PRICE_PACK_40=
# The app's own origin (https://the-99.dev, https://staging.the-99.dev; http://localhost:3000 locally).
# Checkout's return URLs are built from it, never from a request header. Unset, no Session is created.
APP_ORIGIN=
# Buying credits, per reader. 'true' on staging; unset on production until it is walked; 'off' stops sales.
PAYMENTS_ENABLED=
# Invites (plan 2026-10-16-invites.md). The code HMAC's key: 64+ hex characters, a different value per project.
# Unset, no invite QR can be shown (nothing is held) and no code can be sent.
INVITE_CODE_SECRET=
# The newcomer's code email goes by Resend: the-99's own key (re_...) and a sender on its verified domain,
# e.g. "The 99 <invites@mail.the-99.dev>". Either unset, Send code refuses before anything is held.
RESEND_API_KEY=
INVITE_EMAIL_FROM=
# Product analytics (src/lib/analytics/posthog.ts). Leave unset: analytics runs only with a key AND on
# the production hostname, and the key is set in Vercel Production alone (docs/agents/ops.md).
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
