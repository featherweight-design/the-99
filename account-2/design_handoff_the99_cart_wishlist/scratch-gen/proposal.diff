@@ -0,0 +1,78 @@
+"use client";
+// Cart on your wishlist R1 (proposal, account 2, 2026-11-27): the owner's Wishlist tab split by where each line came
+// from. "Added by you" holds the lines the reader added (search, card details); one box per deck holds the cards that
+// deck still needs and the reader does not own, kept in step with the deck. A card two decks need sits in both boxes.
+// Each box is the deck tabs' shipped box (`DeckBox` + `DeckBoxBand`); the tiles inside are the shipped Wishlist tiles.
+// Friends never see this split: their Wishlist tab of the reader is the one shipped list.
+
+import Link from "next/link";
+import { DeckBox, DeckBoxBand } from "../decks/deck-box";
+import { CARD_GRID_TRACKS } from "../ui/card-grid";
+import { GhostButton, HAIRLINE } from "../ui/button";
+import { ArrivalDismiss } from "../decks/arrival-strip";
+
+export const cartWishlistCopy = {
+  you: "Added by you",
+  deck: (name: string) => `For ${name}`,
+  openDeck: "Open deck",
+  offer: {
+    strong: (n: number) => `Your decks need ${n} cards you don’t own.`,
+    rest: "Put them here so friends can see them. They follow your decks, and leave once you have them.",
+    press: "Add them",
+    dismiss: "Not now",
+  },
+  added: (n: number, decks: number) => `Added ${n} cards from ${decks} decks. They’ll follow your decks from now on.`,
+} as const;
+
+export type WishlistGroup = { key: string; kind: "you" | "deck"; name: string; deckHref?: string; count: number; tiles: React.ReactNode[] };
+
+export function WishlistGroups({ groups }: { groups: WishlistGroup[] }) {
+  return (
+    <div className="flex flex-col gap-[14px] px-[14px] pb-[14px] pt-[12px] md:gap-[20px] md:px-[34px] md:pb-[34px] md:pt-[18px]">
+      {groups.map((g) => (
+        <DeckBox key={g.key} data-wishlist-group={g.kind}>
+          <DeckBoxBand
+            title={g.kind === "you" ? cartWishlistCopy.you : cartWishlistCopy.deck(g.name)}
+            count={g.count}
+            aside={
+              g.deckHref ? (
+                <Link href={g.deckHref} className="flex-none font-sans text-[13px] font-medium text-[color:var(--fg-muted)] hover:text-[color:var(--accent-hover)]">
+                  {cartWishlistCopy.openDeck} ›
+                </Link>
+              ) : null
+            }
+          />
+          <ul className={`m-0 grid list-none ${CARD_GRID_TRACKS} gap-[8px] p-[10px] md:gap-[20px] md:p-[16px]`}>{g.tiles}</ul>
+        </DeckBox>
+      ))}
+    </div>
+  );
+}
+
+/** The one-time offer on the tab while the switch is off and the reader's decks need cards: the collected strip's own shell. */
+export function CartOffer({ need }: { need: number }) {
+  return (
+    <div
+      role="status"
+      className="mx-[14px] mt-[12px] flex flex-col gap-[10px] rounded-[10px] border border-solid border-[color:var(--border-strong)] bg-[color:var(--surface-raised)] px-[16px] py-[12px] text-[13.5px] text-[color:var(--fg-body)] md:mx-[34px] md:mt-[14px] md:flex-row md:items-center md:gap-[14px] md:text-[14px]"
+    >
+      <span className="flex min-w-0 flex-1 items-start gap-[12px]">
+        <svg aria-hidden width="14" height="17" viewBox="0 0 24 24" fill="currentColor" className="mt-[2px] flex-none text-[color:var(--accent-text)]">
+          <path d="M6 3h12v18l-6-4-6 4z" />
+        </svg>
+        <span className="min-w-0 flex-1">
+          <span className="font-medium text-[color:var(--fg)]">{cartWishlistCopy.offer.strong(need)}</span> {cartWishlistCopy.offer.rest}
+        </span>
+        <span className="md:hidden">
+          <ArrivalDismiss onDismiss={() => {}} label={cartWishlistCopy.offer.dismiss} />
+        </span>
+      </span>
+      <span className="flex items-center gap-[10px] pl-[26px] md:pl-0">
+        <GhostButton className={`min-h-[44px] rounded-[8px] px-[16px] text-[13px] ${HAIRLINE}`}>{cartWishlistCopy.offer.press}</GhostButton>
+        <span className="hidden md:inline-flex">
+          <ArrivalDismiss onDismiss={() => {}} label={cartWishlistCopy.offer.dismiss} />
+        </span>
+      </span>
+    </div>
+  );
+}
