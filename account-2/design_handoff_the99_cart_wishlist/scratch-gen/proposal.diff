+  searchAriaLabel: "Search your decks",
+  clearSearch: "Clear search",
+  groupDefault: "Your decks",
+  groupSelected: (n: number) => `On your wishlist · ${n}`,
+  groupMatches: (n: number) => `Matches · ${n}`,
