@@ -0,0 +1,42 @@
+"use client";
+// Settings' Wishlist section (Cart on your wishlist R1b, proposal): the one switch that keeps the cards the reader's
+// decks need on their wishlist. Every deck is in unless the reader ticks Keep off my wishlist in that deck's ⋯ menu, so
+// the section is the same height for 5 decks or 50; a line names the decks left out. Drawn as Your decks draws its rows
+// (`friend-decks-section.tsx`): the shipped Checkbox, a name and a line, a mono foot.
+
+import { BandText } from "../decks/deck-box";
+import { SECTION_HEAD } from "../social/friends-list";
+import { Checkbox } from "../ui/checkbox";
+
+export const wishlistSettingsCopy = {
+  head: "Wishlist",
+  explain: "Friends see your wishlist, and their spares are matched against it.",
+  sync: { name: "Add the cards my decks need", line: "Every deck, new ones too. A card leaves once you have it or cut it." },
+  leftOut: (names: string[]) => (names.length === 1 ? `Leaving out ${names[0]}.` : `Leaving out ${names.length} decks: ${names.join(", ")}.`),
+  foot: "To leave a deck out, tick Keep off my wishlist in its ⋯ menu. Cards you add yourself never change here.",
+} as const;
+const c = wishlistSettingsCopy;
+
+export function WishlistSection({ on, leftOut }: { on: boolean; leftOut: string[] }) {
+  return (
+    <section aria-labelledby="settings-wishlist" className="mt-[26px] md:mt-[34px]">
+      <h2 id="settings-wishlist" className={SECTION_HEAD}><BandText text={c.head} /></h2>
+      <p className="m-0 mt-[10px] text-[13px] leading-[1.55] text-[color:var(--fg-muted)]">{c.explain}</p>
+      <ul className="m-0 mt-[4px] list-none p-0">
+        <li>
+          <label className="flex min-h-[44px] cursor-pointer items-start gap-[12px] rounded-[8px] py-[8px]">
+            <Checkbox checked={on} onChange={() => {}} className="mt-[1px]" />
+            <span className="flex min-w-0 flex-1 flex-col gap-[2px]">
+              <b className="font-sans text-[14px] font-medium text-[color:var(--fg)]">{c.sync.name}</b>
+              <span className="text-[12.5px] leading-[1.45] text-[color:var(--fg-muted)]">{c.sync.line}</span>
+              {on && leftOut.length > 0 ? (
+                <span className="text-[12.5px] leading-[1.45] text-[color:var(--fg-body)]">{c.leftOut(leftOut)}</span>
+              ) : null}
+            </span>
+          </label>
+        </li>
+      </ul>
+      <p className="m-0 mt-[10px] font-mono text-[10.5px] leading-[1.6] text-[color:var(--fg-faint)]">{c.foot}</p>
+    </section>
+  );
+}
