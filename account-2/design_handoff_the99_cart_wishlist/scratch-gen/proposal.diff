+  optionAriaUnavailable: (name: string) => `${name}, nothing to buy`,
+  footerTotal: (total: number) => `${total} decks`,
+  footerSelected: (n: number, total: number) => `${n} of ${total} decks`,
+  clear: "Clear",
+  done: "Done",
+  closeLabel: "Close",
+  emptyTitle: "No deck matches",
+  emptyBody: (query: string) => ({ before: "No deck is called ", query, after: "." }),
+  announceMatches: (n: number, query: string) => `${n} decks match ${query}`,
+  announceAdded: (name: string) => `${name} added`,
+  announceRemoved: (name: string) => `${name} left out`,
+  announceCleared: () => "Every deck left out",
+};
+
+export function WishlistSection({ on, decks, chosen, compact }: {
+  on: boolean;
+  /** Every deck, by name, with the cards Shopping lists for it. */
+  decks: { id: string; name: string; toBuy: number }[];
