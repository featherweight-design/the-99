+                disabled={!on}
+                triggerLook="field"
+                compact={compact}
+              />
+            </div>
+          </div>
+        </li>
+      </ul>
+      <p className="m-0 mt-[10px] font-mono text-[10.5px] leading-[1.6] text-[color:var(--fg-faint)]">{c.foot}</p>
+    </section>
+  );
+}
