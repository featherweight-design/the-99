+// PROPOSAL #2980 (R1b): the chooser's second group, "Other decks". Closed by default under the shipped row: one
+// disclosure row with the count. Open, it lists only the committed decks whose colors allow the card (a deck at or
+// over 99 is still offered: it says so). The rows ARE the shipped options (AllocationMark, name, stamp, outcome),
+// in the same single choice as the decks above: picking one adds the card to that deck's draft and gives it the copy.
+import { AllocationMark } from "./contested-card-row";
+import { SearchField } from "../ui/text-field";
+import { Chevron } from "../ui/chevron";
+
+export type OtherDeck = { id: string; name: string; cards: number; picked?: boolean };
+export function OtherDecks({ decks, cardName, open, copies, find, hiddenColors }: {
+  decks: OtherDeck[]; cardName: string; open: boolean; copies: number; find?: string; hiddenColors: number;
+}) {
+  const picked = decks.find((d) => d.picked);
+  const shown = find ? decks.filter((d) => d.name.toLowerCase().includes(find.toLowerCase())) : decks;
+  return (
+    <div className="mt-[10px]" style={{ border: "1px solid var(--border)", borderRadius: 11, background: "var(--surface)" }}>
+      <button type="button" aria-expanded={open}
+        className="flex min-h-[48px] w-full items-center gap-[10px] border-0 bg-transparent px-[13px] text-left">
+        <span className="flex-1 font-mono text-[10px] uppercase tracking-[0.13em]" style={{ color: "var(--fg-body)" }}>
+          Other decks <span style={{ color: "var(--fg-faint)" }}>· {decks.length}</span>
+        </span>
+        {!open && picked ? <span className="truncate text-[12.5px]" style={{ color: "var(--accent-text)" }}>{picked.name}</span> : null}
+        <Chevron kind="disclosure" open={open} className="text-[color:var(--fg-faint)]" />
+      </button>
+      {open ? (
+        <div className="px-[13px] pb-[12px]">
+          {decks.length > 6 ? (
+            <SearchField aria-label="Find a deck" placeholder="Find a deck" defaultValue={find ?? ""} containerClassName="mb-[8px]" />
+          ) : null}
+          <ul role="radiogroup" aria-label={`Other decks for ${cardName}`} className="m-0 flex list-none flex-col gap-[4px] p-0">
+            {shown.map((d) => (
+              <li key={d.id} role="radio" aria-checked={!!d.picked} tabIndex={-1}
+                className="flex min-h-[52px] flex-col justify-center gap-[1px] px-[8px] py-[6px] md:min-h-[44px] md:flex-row md:items-center md:gap-[11px]"
+                style={{ borderRadius: 7, background: "var(--bg)", border: d.picked ? "1px solid var(--accent)" : "1px solid transparent", cursor: "pointer" }}>
+                <span className="flex min-w-0 items-center gap-[11px] md:flex-1">
+                  <AllocationMark allocated={0} copies={copies} commander={false} picked={d.picked} />
+                  <span className="min-w-0 text-[13px] md:truncate" style={{ color: "var(--fg)" }}>{d.name}</span>
+                </span>
+                <span className="flex items-center gap-[8px] pl-[27px] md:flex-none md:pl-0">
+                  <span className="font-mono text-[10.5px] md:text-[11px]" style={{ color: d.cards >= 99 ? "var(--avail-over-fg)" : "var(--fg-faint)" }}>
+                    {d.cards >= 99 ? `${d.cards} cards · makes ${d.cards + 1}` : `${d.cards} cards`}
+                  </span>
+                  <span className="font-mono text-[10.5px] md:text-[11px]" style={{ color: d.picked ? "var(--success)" : "var(--fg-muted)" }}>
+                    {d.picked ? "adds it · gets it" : "adds it"}
+                  </span>
+                </span>
+              </li>
+            ))}
+          </ul>
+          <p className="mb-0 mt-[8px] text-[11px]" style={{ color: "var(--fg-faint)" }}>
+            {picked
+              ? <>{cardName} goes into {picked.name}’s draft and gets this copy when you commit. Tap it again to undo.</>
+              : <>Picking one adds {cardName} to its draft.{hiddenColors > 0 ? ` Decks outside its colors aren’t listed.` : ""}</>}
+          </p>
+        </div>
+      ) : null}
+    </div>
+  );
+}
