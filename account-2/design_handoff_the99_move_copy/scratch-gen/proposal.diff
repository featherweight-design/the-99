+// PROPOSAL #2980 (R1): the chooser's second group. Committed decks that do not list the card: one that can take it
+// offers Add it (into its draft, the pick kept for its commit); one that cannot says why, in the row, never hidden.
+export type OtherDeck = { id: string; name: string; state: "can" | "added" | "colors" | "full" | "commander" };
+const OUT: Record<OtherDeck["state"], string> = {
+  can: "Add it", added: "in the draft · gets it on commit", colors: "outside its colors", full: "has 99 already", commander: "its commander",
+};
+export function OtherDecks({ decks, cardName }: { decks: OtherDeck[]; cardName: string }) {
+  const added = decks.find((d) => d.state === "added");
+  return (
+    <div className="mt-[10px] p-[12px_13px]" style={{ border: "1px solid var(--border)", borderRadius: 11, background: "var(--surface)" }}>
+      <p className="m-0 mb-[7px] font-mono text-[10px] uppercase tracking-[0.13em]" style={{ color: "var(--fg-body)" }}>
+        Not in their lists
+      </p>
+      <ul className="m-0 flex list-none flex-col gap-[4px] p-0">
+        {decks.map((d) => {
+          const no = d.state === "colors" || d.state === "full" || d.state === "commander";
+          return (
+            <li key={d.id} className="flex min-h-[52px] items-center justify-between gap-[11px] px-[8px] py-[6px] md:min-h-[44px]"
+              style={{ borderRadius: 7, background: "var(--bg)", border: no ? "1px dashed var(--border)" : d.state === "added" ? "1px solid var(--accent)" : "1px solid transparent" }}>
+              <span className="min-w-0 truncate text-[13px]" style={{ color: no ? "var(--fg-muted)" : "var(--fg)" }}>{d.name}</span>
+              {d.state === "can" ? (
+                <button type="button" className="-my-[6px] min-h-[44px] flex-none text-[13px] text-[color:var(--accent-text)]" aria-label={`Add ${cardName} to ${d.name} and give it this copy`}>{OUT.can}</button>
+              ) : (
+                <span className="flex-none font-mono text-[10.5px] md:text-[11px]" style={{ color: d.state === "added" ? "var(--success)" : "var(--fg-faint)" }}>{OUT[d.state]}</span>
+              )}
+            </li>
+          );
+        })}
+      </ul>
+      <p className="mb-0 mt-[8px] text-[11px]" style={{ color: "var(--fg-faint)" }}>
+        {added
+          ? <>Added to {added.name}’s draft. It gets this copy when you commit. <span style={{ color: "var(--accent-text)" }}>Undo</span></>
+          : <>Add it puts {cardName} in that deck’s draft. It gets this copy when you commit.</>}
+      </p>
+    </div>
+  );
+}
