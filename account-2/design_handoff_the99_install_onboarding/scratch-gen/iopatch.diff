diff --git a/src/components/pwa/install-row.tsx b/src/components/pwa/install-row.tsx
new file mode 100644
index 0000000..75de9c6
--- /dev/null
+++ b/src/components/pwa/install-row.tsx
@@ -0,0 +1,42 @@
+"use client";
+// The first-run checklist's install row (install onboarding R1; design/design_handoff_the99_install_onboarding/).
+// Unnumbered, under step 3 and above the signature, Friends and news rows. Its box is the Friends row's live box
+// (LockedStep's radius 14 and 56 floor, --surface-inset on --border-strong). Two presses, as the header slot has:
+// the row (opens this browser's how-to sheet on an iPhone, or the held prompt on Android) and a bare ✕ (gone for good).
+//
+// Draws only on an iPhone in Safari, Chrome or Firefox, or with a held `beforeinstallprompt`; never standalone, never
+// once the account's `installedAt` is set (call 4, option A), never after its ✕. While it draws, the header slot
+// steps aside (one ask at a time); its ✕ also counts as one header-slot dismiss (`dismissOnce`).
+import { pwaInstallCopy } from "../../lib/copy/pwa-install";
+
+const c = pwaInstallCopy.row;
+export type InstallRowKind = "safari" | "chrome" | "firefox" | "android";
+
+const BOX =
+  "mt-[7px] flex min-h-[56px] w-full flex-none items-center gap-[12px] rounded-[14px] border border-solid border-[color:var(--border-strong)] bg-[color:var(--surface-inset)] p-[6px_4px_6px_15px] text-left font-sans text-[color:var(--fg-body)] sm:mt-[8px] sm:gap-[14px] sm:p-[7px_6px_7px_18px]";
+
+function Glyph() {
+  // The header slot's own glyph (install-slot.tsx), in the slot the numerals and Friends' + use.
+  return (
+    <span aria-hidden className="box-border flex h-[22px] w-[22px] flex-none items-center justify-center rounded-[6px] border-[1.5px] border-solid border-[color:var(--accent-shadow)] text-[color:var(--accent-text)]">
+      <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M7 2v7M7 9L4 6M7 9l3-3M2 12h10" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" /></svg>
+    </span>
+  );
+}
+
+export function InstallRowView({ kind, onOpen, onDismiss }: { kind: InstallRowKind; onOpen?: () => void; onDismiss?: () => void }) {
+  return (
+    <div data-install-row className={BOX}>
+      <button type="button" onClick={onOpen} className="flex min-h-[44px] min-w-0 flex-1 items-center gap-[12px] border-0 bg-transparent p-0 text-left sm:gap-[14px]">
+        <Glyph />
+        <span className="flex min-w-0 flex-1 flex-col gap-[3px]">
+          <b className="font-display text-[15px] font-semibold text-[color:var(--fg)] sm:text-[16px]">{c.title}</b>
+          <span className="text-[12px] leading-[1.45] text-[color:var(--fg-muted)] sm:text-[12.5px]">{c.line[kind]}</span>
+        </span>
+      </button>
+      <button type="button" onClick={onDismiss} aria-label={c.dismissAria} className="inline-flex h-[44px] w-[44px] flex-none items-center justify-center border-0 bg-transparent text-[color:var(--fg-faint)]">
+        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" /></svg>
+      </button>
+    </div>
+  );
+}
