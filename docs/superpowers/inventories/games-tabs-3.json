      "widths": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/decks/4599e9c9-5ee8-4127-b93b-20d7ce2bec41?tab=games",
          "wait": "[data-games-summary]",
          "settle": 2500
        },
        {
          "scrollTo": "#game-matchups-heading",
