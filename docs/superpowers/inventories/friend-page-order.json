{
  "feature": "A friend's page opens on Decks; the strip reads Decks, Wishlist, Spares (Hugh, 2026-10-30)",
  "clearAbout": true,
  "note": "Needs SOCIAL_FRIENDS_ENABLED on, and a SCRATCH branch seeded with scripts/seed-r2-friend-fixture.mts (COLIN_PUBLIC_ID). The two redirect rows prove old links land: /decks on the bare page, and ?spare= on the Spares tab.",
  "shares": {
    "module": "src/components/place/place-strip.tsx",
    "binding": "PlaceStrip",
    "note": "Collection, Commanders and a friend's page draw one strip."
  },
  "rows": [
    {
      "id": "default-decks",
      "label": "/friends/Colin: opens on Decks, the strip reads Decks, Wishlist, Spares",
      "view": "src/components/social/friend-strip.tsx",
      "steps": [
        { "goto": "/friends/${COLIN_PUBLIC_ID}", "wait": "[data-testid=friend-tab-decks][aria-current=page]", "settle": 2500 }
      ]
    },
    {
      "id": "wishlist",
      "label": "/friends/Colin/wishlist: the middle tab",
      "view": "src/components/social/friend-strip.tsx",
      "steps": [
        { "goto": "/friends/${COLIN_PUBLIC_ID}/wishlist", "wait": "[data-testid=friend-tab-wishlist][aria-current=page]", "settle": 2500 }
      ]
    },
    {
      "id": "spares",
      "label": "/friends/Colin/spares: the last tab, its own address now",
      "view": "src/components/social/friend-strip.tsx",
      "steps": [
        { "goto": "/friends/${COLIN_PUBLIC_ID}/spares", "wait": "[data-testid=friend-tab-spares][aria-current=page]", "settle": 2500 }
      ]
    },
    {
      "id": "old-decks-link",
      "label": "/friends/Colin/decks (an old link): lands on the page, on Decks",
      "view": "src/components/social/friend-strip.tsx",
      "steps": [
        { "goto": "/friends/${COLIN_PUBLIC_ID}/decks", "wait": "[data-testid=friend-tab-decks][aria-current=page]", "settle": 2500 }
      ]
    },
    {
      "id": "old-spare-link",
      "label": "/friends/Colin?spare= (an old push): lands on Spares",
      "view": "src/components/social/friend-strip.tsx",
      "steps": [
        { "goto": "/friends/${COLIN_PUBLIC_ID}?spare=00000000-0000-4000-8000-000000000000", "wait": "[data-testid=friend-tab-spares][aria-current=page]", "settle": 2500 }
      ]
    }
  ]
}
