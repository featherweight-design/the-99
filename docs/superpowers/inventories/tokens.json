{
  "feature": "Tokens for my deck (PR 4b): the Tokens group on the deck page",
  "note": "Run against a scratch branch holding a pull:staging copy under the audit account, DECK_TOKENS_ENABLED=true on the dev server. TOKENS_AANG, TOKENS_OMNATH and TOKENS_WIZARDS are deck ids of that account; the account has been READ for tokens (a token_reads row), holds Ally from an upload, and has Food and Soldier joined on Aang. The unread and failed states are tokens-unknown.json and tokens-failed.json. The two rows that press a control are tokens-presses.json, because a press changes the account and every later row would photograph the changed state.",
  "out": "contact-sheets/tokens",
  "clearAbout": true,
  "widths": [
    {
      "label": "phone",
      "width": 390,
      "height": 844
    },
    {
      "label": "desktop",
      "width": 900,
      "height": 900
    }
  ],
  "rows": [
    {
      "id": "aang-read",
      "label": "/decks/[id] Your deck, All: Aang read (Ally in your collection, Monk not, Food and Soldier In Shopping)",
      "view": "src/components/decks/tokens-group.tsx",
      "steps": [
        {
          "goto": "/decks/${TOKENS_AANG}",
          "wait": "#deck-tokens-heading",
          "settle": 1500
        },
        {
          "scrollTo": "#deck-tokens-heading"
        }
      ]
    },
    {
      "id": "aang-opened",
      "label": "/decks/[id]: Aang's Ally row opened, its makers listed A to Z",
      "view": "src/components/decks/tokens-group.tsx",
      "steps": [
        {
          "goto": "/decks/${TOKENS_AANG}",
          "wait": "#deck-tokens-heading",
          "settle": 1500
        },
        {
          "clickRole": "button",
          "name": "^Ally ",
          "settle": 600
        },
        {
          "scrollTo": "#deck-tokens-heading"
        }
      ]
    },
    {
      "id": "omnath",
      "label": "/decks/[id]: Omnath, 14 token rows including Copy",
      "view": "src/components/decks/tokens-group.tsx",
      "steps": [
        {
          "goto": "/decks/${TOKENS_OMNATH}",
          "wait": "#deck-tokens-heading",
          "settle": 1500
        },
        {
          "scrollTo": "#deck-tokens-heading"
        }
      ]
    },
    {
      "id": "wizards",
      "label": "/decks/[id]: Wizards, whose only token is Copy (an ordinary row)",
      "view": "src/components/decks/tokens-group.tsx",
      "steps": [
        {
          "goto": "/decks/${TOKENS_WIZARDS}",
          "wait": "#deck-tokens-heading",
          "settle": 1500
        },
        {
          "scrollTo": "#deck-tokens-heading"
        }
      ]
    },
    {
      "id": "aang-card-view",
      "label": "/decks/[id] Card view: the group stays rows (T7)",
      "view": "src/components/decks/tokens-group.tsx",
      "steps": [
        {
          "goto": "/decks/${TOKENS_AANG}",
          "wait": "#deck-tokens-heading",
          "settle": 1200
        },
        {
          "clickRole": "button",
          "name": "Card view",
          "settle": 900
        },
        {
          "scrollTo": "#deck-tokens-heading"
        }
      ]
    },
    {
      "id": "aang-shopping",
      "label": "/decks/[id] Shopping: Aang's joined tokens, the buy box counting them (the Tokens group is in tokens-shopping.json)",
      "view": "src/components/decks/decklist.tsx",
      "steps": [
        {
          "goto": "/decks/${TOKENS_AANG}",
          "wait": "[role=tablist]",
          "settle": 1000
        },
        {
          "clickRole": "button",
          "name": "Shopping",
          "settle": 800
        }
      ]
    },
    {
      "id": "neg-decks",
      "label": "/decks with the switch on: no Tokens anywhere",
      "view": "src/app/decks/page.tsx",
      "steps": [
        {
          "goto": "/decks",
          "wait": "div",
          "settle": 1200
        }
      ]
    },
    {
      "id": "neg-home",
      "label": "Home with the switch on: no Tokens anywhere",
      "view": "src/app/page.tsx",
      "steps": [
        {
          "goto": "/",
          "wait": "div",
          "settle": 1200
        }
      ]
    },
    {
      "id": "neg-collection",
      "label": "/collection with the switch on: no Tokens anywhere",
      "view": "src/app/collection/page.tsx",
      "steps": [
        {
          "goto": "/collection",
          "wait": "div",
          "settle": 1500
        }
      ]
    }
  ]
}
