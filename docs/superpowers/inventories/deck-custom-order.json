{
  "feature": "Deck custom order: the Custom sort, the Arrange row, and Arrange mode (handoff #2999 PR 1, #2990)",
  "note": "One route, /decks, and Arrange is a MODE of it, not a route. Rows follow the boards: O1 (the sort menu with Custom and `Arrange decks…`), O2/RO (Arrange, All decks, phone and desktop), the lifted row, RO-folder (Arrange inside a folder, with its shelf note), the leave guard (Cancel after a move), and the list sorted Custom after Done. Needs `DECK_FOLDER_ID` (a folder holding decks). Row order matters: the `Done` row WRITES the account's deck order, so it is last and a scratch branch carries it; the Custom row before it relies on no saved order. The flip strip and arrow keys are PR 2 and are not here. No `shares` block: nothing else mounts Arrange.",
  "rows": [
    {
      "id": "sort-menu",
      "label": "/decks, the sort menu open: Custom and the Arrange row (O1)",
      "steps": [
        { "goto": "/decks", "wait": "button[aria-haspopup=\"menu\"]", "settle": 3000 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]", "settle": 800 }
      ]
    },
    {
      "id": "pick-custom-seeds-arrange",
      "label": "/decks, Custom picked with no saved order: Arrange opens seeded from the screen (O2)",
      "steps": [
        { "goto": "/decks", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]" },
        { "clickRole": "menuitemradio", "name": "^Custom", "wait": "section[aria-label=\"Arrange decks\"]", "settle": 1500 }
      ]
    },
    {
      "id": "arrange-all",
      "label": "/decks, Arrange decks from the menu row, All decks at rest (O2 / RO)",
      "steps": [
        { "goto": "/decks", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]" },
        { "clickRole": "menuitem", "name": "^Arrange decks", "wait": "section[aria-label=\"Arrange decks\"]", "settle": 1500 }
      ]
    },
    {
      "id": "arrange-lifted",
      "label": "/decks, Arrange with a row lifted and moved one place (the lift)",
      "steps": [
        { "goto": "/decks", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]" },
        { "clickRole": "menuitem", "name": "^Arrange decks", "wait": "section[aria-label=\"Arrange decks\"]", "settle": 1000 },
        { "clickRole": "button", "name": "^Move ", "settle": 300 },
        { "pressKey": "Space", "settle": 300 },
        { "pressKey": "ArrowDown", "wait": "button[aria-pressed=\"true\"]", "settle": 600 }
      ]
    },
    {
      "id": "arrange-folder",
      "label": "/decks?folder, Arrange inside a folder: `Arrange <folder>…` with the shelf note (RO-folder)",
      "steps": [
        { "goto": "/decks?folder=${DECK_FOLDER_ID}", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]", "settle": 600 }
      ]
    },
    {
      "id": "arrange-folder-open",
      "label": "/decks?folder, the folder's Arrange screen",
      "steps": [
        { "goto": "/decks?folder=${DECK_FOLDER_ID}", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]" },
        { "clickRole": "menuitem", "name": "^Arrange (?!decks)", "wait": "section[aria-label^=\"Arrange \"]", "settle": 1500 }
      ]
    },
    {
      "id": "arrange-leave-guard",
      "label": "/decks, Arrange after a move, Cancel pressed: the leave guard open",
      "steps": [
        { "goto": "/decks", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]" },
        { "clickRole": "menuitem", "name": "^Arrange decks", "wait": "section[aria-label=\"Arrange decks\"]", "settle": 1000 },
        { "clickRole": "button", "name": "^Move ", "settle": 300 },
        { "pressKey": "Space", "settle": 300 },
        { "pressKey": "ArrowDown", "settle": 300 },
        { "pressKey": "Space", "settle": 300 },
        { "clickRole": "button", "name": "^Cancel$", "wait": "[role=alertdialog]", "settle": 600 }
      ]
    },
    {
      "id": "sorted-custom-after-done",
      "label": "/decks, a deck moved, Done pressed: the list sorted Custom (WRITES the order; scratch branch only)",
      "steps": [
        { "goto": "/decks", "wait": "button[aria-haspopup=\"menu\"]", "settle": 2500 },
        { "clickRole": "button", "name": "^Sort · ", "wait": "[role=menu]" },
        { "clickRole": "menuitem", "name": "^Arrange decks", "wait": "section[aria-label=\"Arrange decks\"]", "settle": 1000 },
        { "clickRole": "button", "name": "^Move ", "settle": 300 },
        { "pressKey": "Space", "settle": 300 },
        { "pressKey": "ArrowDown", "settle": 300 },
        { "pressKey": "ArrowDown", "settle": 300 },
        { "pressKey": "Space", "settle": 300 },
        { "clickRole": "button", "name": "^Done$", "wait": "button[aria-label*=\"Custom\"]", "settle": 2500 }
      ]
    }
  ]
}
