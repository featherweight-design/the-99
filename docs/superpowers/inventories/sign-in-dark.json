{
  "feature": "Custom sign-in (dark), Small items 11 item 4 A2: /sign-in P1 to P6, G1, and /sso-callback (boards Sign-In-Invite-Only, Sign-In-Methods)",
  "note": "Signed out. A scratch Neon branch from local-dev on the server. The email is a never-registered address on the Clerk dev instance, so every Clerk answer is the unknown-email one: the screens must read as they would for a real account.",
  "out": "contact-sheets/sign-in-dark",
  "signedOut": true,
  "widths": [
    { "label": "phone", "width": 390, "height": 844 },
    { "label": "desktop", "width": 1300, "height": 900 }
  ],
  "rows": [
    { "id": "p1", "label": "P1 sign in", "view": "src/components/sign-in/sign-in-flow.tsx",
      "steps": [ { "goto": "/sign-in", "wait": "input[type=email]", "settle": 1200 } ] },
    { "id": "p2", "label": "P2 password (any email)", "view": "src/components/sign-in/sign-in-flow.tsx",
      "steps": [ { "goto": "/sign-in", "wait": "input[type=email]" },
                 { "fill": "input[type=email]", "text": "nobody-proof+clerk_test@the99.app" },
                 { "clickRole": "button", "name": "^Continue$" },
                 { "wait": "input[type=password]", "settle": 800 } ] },
    { "id": "p3", "label": "P3 it didn't work (unknown email)", "view": "src/components/sign-in/sign-in-flow.tsx",
      "steps": [ { "goto": "/sign-in", "wait": "input[type=email]" },
                 { "fill": "input[type=email]", "text": "nobody-proof+clerk_test@the99.app" },
                 { "clickRole": "button", "name": "^Continue$" },
                 { "fill": "input[type=password]", "text": "not-a-real-password-1" },
                 { "clickRole": "button", "name": "^Sign in$", "settle": 3000 } ] },
    { "id": "p4", "label": "P4 email me a code", "view": "src/components/sign-in/sign-in-flow.tsx",
      "steps": [ { "goto": "/sign-in", "wait": "input[type=email]" },
                 { "fill": "input[type=email]", "text": "nobody-proof+clerk_test@the99.app" },
                 { "clickRole": "button", "name": "^Continue$" },
                 { "clickRole": "button", "name": "Email me a code instead", "settle": 3000 } ] },
    { "id": "p6", "label": "P6 forgot password", "view": "src/components/sign-in/sign-in-flow.tsx",
      "steps": [ { "goto": "/sign-in", "wait": "input[type=email]" },
                 { "fill": "input[type=email]", "text": "nobody-proof+clerk_test@the99.app" },
                 { "clickRole": "button", "name": "^Continue$" },
                 { "clickRole": "button", "name": "Forgot password", "settle": 3500 } ] },
    { "id": "g1", "label": "G1 Google refused", "view": "src/components/sign-in/sign-in-flow.tsx",
      "steps": [ { "goto": "/sign-in?google=refused", "wait": "input[type=email]", "settle": 1200 } ] },
    { "id": "sso", "label": "/sso-callback with no sign-in (lands on G1)", "view": "src/components/sign-in/sso-callback.tsx",
      "steps": [ { "goto": "/sso-callback", "settle": 5000 } ] }
  ]
}
