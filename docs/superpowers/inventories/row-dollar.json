          "settle": 1500
        },
        {
          "goto": "/decks/441286bb-f632-4d1e-af0f-aa7282bbb40f",
          "wait": "[role=tablist]",
          "settle": 1500
        },
        {
          "wait": "[data-decklist-row]",
          "settle": 1200
        },
        {
          "scrollTo": "[data-decklist-row]",
          "settle": 400
        }
      ],
      "view": "src/components/decks/decklist-row.tsx"
    },
    {
      "id": "all-heavy",
      "label": "Gishath All: a heavy row (combo and facts) keeps one more mark at each tier before its +N",
      "steps": [
        {
          "goto": "/decks/441286bb-f632-4d1e-af0f-aa7282bbb40f",
          "wait": "[role=tablist]",
          "settle": 1500
        },
        {
          "wait": "[data-decklist-row]",
          "settle": 1200
        },
        {
          "scrollTo": "[data-decklist-row]:has([data-testid=combo-glyph])",
          "settle": 400
        }
      ],
      "view": "src/components/decks/decklist-row.tsx"
    },
    {
      "id": "shopping-plus",
      "label": "Gishath Shopping: the price is kept, and the +N stands in for folded marks in the middle and tight tiers",
      "steps": [
        {
          "goto": "/decks/441286bb-f632-4d1e-af0f-aa7282bbb40f",
