      "view": "src/components/decks/decklist-row.tsx"
    },
    {
      "id": "all-dollar-tooltip",
      "label": "Gishath All: the `$`'s tooltip under a fine pointer, the price and `needs buying`",
      "steps": [
        {
          "goto": "/decks/441286bb-f632-4d1e-af0f-aa7282bbb40f",
          "wait": "[role=tablist]",
          "settle": 1500
        },
        {
          "wait": "[data-decklist-row]",
          "settle": 1200
