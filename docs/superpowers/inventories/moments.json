        },
        {
          "clearVisit": true
        },
        {
          "goto": "/decks/${OVER_DECK}",
          "wait": "[role=tablist]",
          "settle": 1500
        },
        {
          "settle": 900,
          "waitNote": "Proposed cuts, a tip"
