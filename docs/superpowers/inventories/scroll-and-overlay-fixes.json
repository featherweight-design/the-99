{
  "feature": "Scroll and overlay fixes",
  "rows": [
    {
      "id": "collection-filters-sheet",
      "label": "/collection — Filters sheet over a scrolled list",
      "steps": [
        {
          "goto": "/collection",
          "settle": 3000,
          "wait": "main, [role=main], h1"
        },
        {
          "scroll": 400,
          "settle": 400
        },
        {
          "clickRole": "button",
          "name": "^Filter cards",
          "wait": "[role=dialog]",
          "settle": 800
        }
      ],
      "widths": [
        "phone"
      ]
    },
    {
      "id": "collection-sort-panel",
