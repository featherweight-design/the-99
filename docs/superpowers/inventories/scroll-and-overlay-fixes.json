    {
      "id": "set-head-open",
      "label": "/collection/sets — the head at rest",
      "steps": [
        {
          "goto": "/collection/sets/${PROBE_SET}",
          "settle": 3500,
          "wait": "[data-set-head]"
        }
      ]
    },
    {
      "id": "set-head-collapsed",
      "label": "/collection/sets — the collapsed bar, and no band under it",
      "steps": [
        {
          "goto": "/collection/sets/${PROBE_SET}",
          "settle": 3500,
          "wait": "[data-set-head]"
