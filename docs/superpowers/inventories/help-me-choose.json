{
  "feature": "Help me choose (sub-project 8): the intake form, the results, the deeper look, the doors and the hand-off",
  "note": "Needs a server with HELP_ME_CHOOSE_ENABLED=true. Every row is reached by URL: the form is /decks/new/choose, and a submit goes to v=submit, which resolves the words and redirects to the results. The deeper-done row needs the stub a dev server uses by default, with INTAKE_STUB=wider so the look adds a theme; it spends one credit of the fixture account's allowance per width.",
  "rows": [
    {
      "id": "form-blank",
      "label": "/decks/new/choose: the form, blank (2a)",
      "view": "src/components/intake/intake-form.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose",
          "wait": "textarea",
          "settle": 1500
        }
      ]
    },
    {
      "id": "form-filled",
      "label": "/decks/new/choose: the form, pre-filled from answers (Change answers)",
      "view": "src/components/intake/intake-form.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?w=big+dumb+lizards+that+stomp&c=r,g&t=dinosaurs&b=150&k=3",
          "wait": "textarea",
          "settle": 1500
        }
      ]
    },
    {
      "id": "results-theme",
      "label": "results: a theme and words, submitted (4a, best fits)",
      "view": "src/components/intake/choose-results.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?w=dinosaurs+that+stomp%2C+lots+of+little+tokens+under+%24200&v=submit",
          "wait": "[data-testid='order-line']",
          "settle": 6000
        }
      ]
    },
    {
      "id": "results-owned",
      "label": "results: no theme or card, the owned order",
      "view": "src/components/intake/choose-results.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?c=g&v=results",
          "wait": "[data-testid='order-line']",
          "settle": 6000
        }
      ]
    },
    {
      "id": "results-narrow",
      "label": "results: too narrow, a few fit",
      "view": "src/components/intake/narrow-note.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?c=g&m=exact&t=dinosaurs&k=2&v=results",
          "wait": "[data-testid='narrow-few'], [data-testid='narrow-none'], [data-testid='order-line']",
          "settle": 6000
        }
      ]
    },
    {
      "id": "results-few",
      "label": "results: a few fit",
      "view": "src/components/intake/narrow-note.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?c=r,g&m=exact&t=dinosaurs,tokens&k=2&v=results",
          "wait": "[data-testid='narrow-few']",
          "settle": 6000
        }
      ]
    },
    {
      "id": "results-none",
      "label": "results: nothing fits",
      "view": "src/components/intake/narrow-note.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?c=w,u,b,r,g&m=exact&t=dinosaurs&b=1&k=1&v=results",
          "wait": "[data-testid='narrow-none']",
          "settle": 6000
        }
      ]
    },
    {
      "id": "deeper-done",
      "label": "results: after a deeper look (3c), the added chip dashed and the panel done",
      "view": "src/components/intake/deeper-look.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?w=dinosaurs+that+stomp+contact&v=submit",
          "wait": "[data-testid='order-line']",
          "settle": 2000
        },
        {
          "clickRole": "button",
          "name": "Look deeper"
        },
        {
          "wait": "[data-testid='deeper-look'][data-phase='done']",
          "settle": 3000
        }
      ]
    },
    {
      "id": "door-picker",
      "label": "/decks/new: the create picker's door (1a)",
      "view": "src/components/decks/create-picker.tsx",
      "steps": [
        {
          "goto": "/decks/new",
          "wait": "[data-testid='help-me-choose-door']",
          "settle": 1500
        }
      ]
    },
    {
      "id": "door-discover",
      "label": "/discover: the result line's link, carrying Red and Green (1b)",
      "view": "src/components/commanders/rack/filter-rack.tsx",
      "steps": [
        {
          "goto": "/discover?c=R,G",
          "wait": "[data-testid='discover-choose-link']",
          "settle": 2500
        }
      ]
    },
    {
      "id": "hand-off",
      "label": "/decks/new: pre-filled from a result, with Built from your answers (6a)",
      "view": "src/components/decks/create-pre-filled.tsx",
      "steps": [
        {
          "goto": "/decks/new/choose?t=dinosaurs&b=150&k=2&v=results",
          "wait": "[data-testid='row-hand-off']",
          "settle": 3000
        },
        {
          "click": "[data-testid='row-hand-off']"
        },
        {
          "wait": "[data-testid='hand-off-answers']",
          "settle": 2000
        }
      ]
    }
  ]
}
