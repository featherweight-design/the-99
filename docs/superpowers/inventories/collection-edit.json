      ]
    },
    {
      "id": "add-discard",
      "label": "Add cards: closing with an unsaved line asks first",
      "view": "src/components/collection/collection-place-head.tsx",
      "steps": [
        {
          "goto": "/collection",
          "wait": "main, [role=main], h1",
          "settle": 6000
