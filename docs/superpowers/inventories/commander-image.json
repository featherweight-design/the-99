{
  "feature": "One commander image — every render of a commander's art",
  "note": "Written at close-out rather than before implementation, which is the wrong order and is recorded as such: the round shipped before this repository had a contact sheet. Every row is a surface the round changed. One row per VIEW rather than per route, because `check:shared` reads a row's own file and does not follow composition — Home draws two of these washes from two components, and the deck header draws one from each spine. The commander picker's thumbs are a different leaf and have their own inventory (`commander-thumb.json`).",
  "rows": [
    {
      "id": "home-hero",
      "label": "/ — the ready-to-build hero",
      "view": "src/components/home/hero-commander.tsx",
      "steps": [
        {
          "goto": "/",
          "settle": 2500,
          "wait": "main, [role=main], h1"
        }
      ]
    },
    {
      "id": "home-resume",
      "label": "/ — the resume rows",
      "view": "src/components/home/resume-decks.tsx",
      "steps": [
        {
          "goto": "/",
          "settle": 2500,
          "wait": "main, [role=main], h1"
        }
      ]
    },
    {
      "id": "commanders",
      "label": "/commanders — the owned lane's rows",
      "view": "src/components/commanders/rec-card.tsx",
      "steps": [
        {
          "goto": "/commanders",
          "settle": 3000,
          "wait": "main, [role=main], h1"
        }
      ]
    },
    {
      "id": "discover",
      "label": "/discover — the discovery rows",
      "view": "src/components/commanders/discovery-row.tsx",
      "steps": [
        {
          "goto": "/discover",
          "settle": 3000,
          "wait": "main, [role=main], h1"
        }
      ]
    },
    {
      "id": "commander-detail",
      "label": "/commanders/<slug> — the detail hero",
      "view": "src/components/commanders/detail.tsx",
      "steps": [
        {
          "goto": "/commanders",
          "settle": 3000,
          "wait": "main, [role=main], h1"
        },
        {
          "click": "a[href^=\"/commanders/\"]",
          "wait": "h1",
          "settle": 3000
        }
      ]
    },
    {
      "id": "decks",
      "label": "/decks — the deck tiles",
      "view": "src/components/decks/deck-card.tsx",
      "steps": [
        {
          "goto": "/decks",
          "settle": 3000,
          "wait": "main, [role=main], h1"
        }
      ]
    },
    {
      "id": "deck-header-phone",
      "label": "/decks/<id> — the phone spine",
      "view": "src/components/decks/spine-mobile.tsx",
      "steps": [
        {
          "goto": "/decks",
          "settle": 3000,
          "wait": "ul a[href^=\"/decks/\"]"
        },
        {
          "click": "ul a[href^=\"/decks/\"]:not([href$=\"/new\"]):not([href$=\"/import\"])",
          "wait": "h1",
          "settle": 3500
        }
      ]
    },
    {
      "id": "deck-header-desktop",
      "label": "/decks/<id> — the desktop spine",
      "view": "src/components/decks/spine-desktop.tsx",
      "steps": [
        {
          "goto": "/decks",
          "settle": 3000,
          "wait": "ul a[href^=\"/decks/\"]"
        },
        {
          "click": "ul a[href^=\"/decks/\"]:not([href$=\"/new\"]):not([href$=\"/import\"])",
          "wait": "h1",
          "settle": 3500
        }
      ]
    }
  ],
