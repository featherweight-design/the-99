    },
    {
      "id": "precons",
      "label": "/decks/precons?tool=precons: the top of the page, no halo",
      "view": "src/lib/discovery/tools.ts",
      "steps": [{ "goto": "/decks/precons?tool=precons", "wait": "input[type='search']", "settle": 800 }]
    },
    {
      "id": "wishlist",
      "label": "/collection/wishlist?tool=wishlist: no halo",
      "view": "src/lib/discovery/tools.ts",
      "steps": [{ "goto": "/collection/wishlist?tool=wishlist", "wait": "input[type='search']", "settle": 800 }]
    },
    {
      "id": "sync",
      "label": "/collection/replace?tool=collection-sync: no halo",
      "view": "src/lib/discovery/tools.ts",
      "steps": [{ "goto": "/collection/replace?tool=collection-sync", "wait": "label:has(input[aria-label='Upload collection CSV'])", "settle": 800 }]
    },
    {
      "id": "lineup",
      "label": "/decks?view=stats&tool=lineup: no halo",
      "view": "src/lib/discovery/tools.ts",
      "steps": [{ "goto": "/decks?view=stats&tool=lineup", "wait": "[role='tablist']", "settle": 800 }]
