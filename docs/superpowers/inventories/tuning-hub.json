        {
          "clickRole": "tab",
          "name": "Analysis",
          "settle": 700
        },
        {
          "wait": "[data-tool-tile='cuts']",
          "settle": 900
        },
        {
          "click": "[data-tool-tile='cuts']",
          "settle": 900
        },
        {
          "wait": "[data-tuning-tool='cuts']",
          "settle": 900
        },
        {
          "scrollTo": "[data-tuning-hub]",
