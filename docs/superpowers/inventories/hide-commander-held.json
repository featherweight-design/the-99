{
  "feature": "Hide a commander, PR 6: the lists' search finding a hidden commander (README section 4 first bullet, Page board state 7)",
  "note": "Needs the signed-in account to have hidden exactly Preston Garvey, Minuteman (owned), Rasputin Dreamweaver and Aang and Katara (unowned), and nothing else, on a scratch branch. The search is typed, not put in the URL, so the settle and the one server lookup per settled query are what is photographed. Rows leave the data as they found it.",
  "widths": [
    { "label": "phone", "width": 390, "height": 844 },
    { "label": "desktop", "width": 1300, "height": 900 }
  ],
  "rows": [
    {
      "id": "foryou-held",
      "label": "For you, \"preston\": the held state names the hidden commander and offers its page",
      "view": "src/components/commanders/commanders-view.tsx",
      "steps": [
        { "goto": "/commanders", "wait": "input[type=search]:visible", "settle": 1500 },
        { "fill": "input[type=search]:visible", "text": "preston", "wait": "a:has-text(\"Open its page\"):visible", "settle": 800 }
      ]
    },
    {
      "id": "foryou-open",
      "label": "For you held state, Open its page pressed: the commander's page, saying Hidden",
      "view": "src/components/commanders/commanders-view.tsx",
      "steps": [
        { "goto": "/commanders", "wait": "input[type=search]:visible", "settle": 1500 },
        { "fill": "input[type=search]:visible", "text": "preston", "wait": "a:has-text(\"Open its page\"):visible", "settle": 500 },
        { "clickRole": "link", "name": "^Open its page$", "wait": "[data-hidden-note]:visible", "settle": 1500 }
      ]
    },
    {
      "id": "discover-held",
      "label": "Discover, \"dreamweaver\": the held state for a hidden match",
      "view": "src/components/commanders/discovery-view.tsx",
      "steps": [
        { "goto": "/commanders/discover", "wait": "input[type=search]:visible", "settle": 1500 },
        { "fill": "input[type=search]:visible", "text": "dreamweaver", "wait": "a:has-text(\"Open its page\"):visible", "settle": 800 }
      ]
    },
    {
      "id": "discover-open",
      "label": "Discover held state, Open its page pressed: the commander's page, saying Hidden",
      "view": "src/components/commanders/discovery-view.tsx",
      "steps": [
        { "goto": "/commanders/discover", "wait": "input[type=search]:visible", "settle": 1500 },
        { "fill": "input[type=search]:visible", "text": "dreamweaver", "wait": "a:has-text(\"Open its page\"):visible", "settle": 500 },
        { "clickRole": "link", "name": "^Open its page$", "wait": "[data-hidden-note]:visible", "settle": 1500 }
      ]
    },
    {
      "id": "discover-aside",
      "label": "Discover, \"rasputin\": one sentence above the live list for the hidden match",
      "view": "src/components/commanders/excluded-match.tsx",
      "steps": [
        { "goto": "/commanders/discover", "wait": "input[type=search]:visible", "settle": 1500 },
        { "fill": "input[type=search]:visible", "text": "rasputin", "wait": "a:has-text(\"Open its page\"):visible", "settle": 800 }
      ]
    }
  ]
}
