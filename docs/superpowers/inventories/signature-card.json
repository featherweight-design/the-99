      "steps": [{ "goto": "/friends", "wait": "h1:visible", "settle": 2500 }]
    },
    {
      "id": "picker-search",
      "label": "Search any card: type line under the name, N printings › (P2, D1)",
      "view": "src/components/social/signature-picker.tsx",
      "steps": [
        { "goto": "/friends", "wait": "h1:visible", "settle": 2500 },
        { "clickRole": "button", "name": "^Your signature card: Mystical Tutor", "waitDialog": "Your signature card", "settle": 800 },
        { "fill": "[role=combobox]", "text": "sol", "settle": 2500 }
      ]
    },
    {
      "id": "picker-no-match",
      "label": "No card matches (P3)",
      "view": "src/components/social/signature-picker.tsx",
      "steps": [
        { "goto": "/friends", "wait": "h1:visible", "settle": 2500 },
        { "clickRole": "button", "name": "^Your signature card: Mystical Tutor", "waitDialog": "Your signature card", "settle": 800 },
        { "fill": "[role=combobox]", "text": "xqzv", "settle": 2500 }
      ]
    },
    {
      "id": "picker-printings",
      "label": "A card's printings: preview, set search, Usual art first (P5, D2)",
      "view": "src/components/social/signature-picker.tsx",
      "steps": [
        { "goto": "/friends", "wait": "h1:visible", "settle": 2500 },
        { "clickRole": "button", "name": "^Your signature card: Mystical Tutor", "waitDialog": "Your signature card", "settle": 800 },
        { "fill": "[role=combobox]", "text": "sol ring", "settle": 2500 },
        { "clickRole": "button", "name": "^Sol Ring, \\d+ printings", "waitDialog": "Sol Ring", "settle": 3000 }
      ]
    },
    {
      "id": "picker-gone",
      "label": "The picked printing is gone: the note, and Usual art reads Shown now (P8)",
      "view": "src/components/social/signature-picker.tsx",
      "steps": [
        { "goto": "/friends", "wait": "h1:visible", "settle": 2500 },
        { "clickRole": "button", "name": "^Your signature card: Mystical Tutor", "waitDialog": "Your signature card", "settle": 800 },
        { "fill": "[role=combobox]", "text": "mystical tutor", "settle": 2500 },
        { "clickRole": "button", "name": "^Mystical Tutor, \\d+ printings", "waitDialog": "Mystical Tutor", "settle": 3000 }
      ]
