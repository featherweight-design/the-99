{
  "feature": "Combos one piece away (combos-close handoff): the deck page segment, its list sheet and the combo pushed inside it, and card details' combo block (UI-3)",
  "note": "Needs NEAR_COMBOS_ENABLED='true' on the server and three decks the signed-in account owns: COMBOS_MANY_DECK (many two-card near combos, a piece held in several decks; local-dev HD - Brago d3f9ccb4-8ed9-47e1-8b68-9b6fcd4bc85c), COMBOS_ONE_DECK (exactly one; HD -Thorin bc4f48f5-af6b-424a-9f1f-6cd9b44f9809) and COMBOS_NONE_DECK (none; HD - Soldiers 8a32d0d2-5fb8-4142-9901-b3e391c0714a).",
  "clearAbout": true,
  "widths": [
    {
      "label": "phone",
      "width": 390,
      "height": 844
    },
    {
      "label": "tablet",
      "width": 820,
      "height": 1000
    },
    {
      "label": "desktop",
      "width": 1300,
      "height": 900
    }
  ],
  "rows": [
    {
      "id": "segment-many",
      "label": "/decks/[id] many: the segment after the version",
      "view": "src/components/decks/todo-foot.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-combos-close]",
          "settle": 1200
        },
        {
          "scrollTo": "[data-combos-close]",
          "settle": 400
        }
      ]
    },
    {
      "id": "sheet-many",
      "label": "/decks/[id] many: the list, You own it then To buy",
      "view": "src/components/decks/combos-close-sheet.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-combos-close]",
          "settle": 1200
        },
        {
          "click": "[data-combos-close]",
          "settle": 900
        }
      ]
    },
    {
      "id": "sheet-one",
      "label": "/decks/[id] one: one combo, singular title and lead",
      "view": "src/components/decks/combos-close-sheet.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_ONE_DECK}",
          "wait": "[data-combos-close]",
          "settle": 1200
        },
        {
          "click": "[data-combos-close]",
          "settle": 900
        }
      ]
    },
    {
      "id": "none",
      "label": "/decks/[id] none: no segment",
      "view": "src/components/decks/todo-foot.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_NONE_DECK}",
          "wait": "[role=tablist]",
          "settle": 1500
        }
      ]
    },
    {
      "id": "detail-spare",
      "label": "/decks/[id] many: a spare combo pushed inside the sheet (\u2190 N combos, plates, steps, Spellbook and Add)",
      "view": "src/components/decks/combos-close-sheet.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-combos-close]",
          "settle": 1200
        },
        {
          "click": "[data-combos-close]",
          "settle": 900
        },
        {
          "click": "[data-where=spare] [data-combo-press] >> nth=0",
          "settle": 900
        }
      ]
    },
    {
      "id": "detail-buy",
      "label": "/decks/[id] many: a combo to buy pushed (the missing plate's price and outline)",
      "view": "src/components/decks/combos-close-sheet.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-combos-close]",
          "settle": 1200
        },
        {
          "click": "[data-combos-close]",
          "settle": 900
        },
        {
          "click": "[data-where=buy] [data-combo-press] >> nth=0",
          "settle": 900
        }
      ]
    },
    {
      "id": "card-closed",
      "label": "card details from /decks/[id] many: the combo block closed, its counts",
      "view": "src/components/cards/combo-partners-detail.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-decklist-row]",
          "settle": 1500
        },
        {
          "click": "[data-decklist-row]:has([data-testid=combo-glyph])",
          "wait": "[role=dialog]",
          "settle": 1500
        },
        {
          "scrollTo": "[data-testid=combo-partners-block]",
          "settle": 400
        }
      ]
    },
    {
      "id": "card-split",
      "label": "card details from /decks/[id] many: the block open, Whole in this deck then One piece away, each line's where",
      "view": "src/components/cards/combo-partners-detail.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-decklist-row]",
          "settle": 1500
        },
        {
          "click": "[data-decklist-row]:has([data-testid=combo-glyph])",
          "wait": "[role=dialog]",
          "settle": 1500
        },
        {
          "scrollTo": "[data-testid=combo-partners-block]",
          "settle": 400
        },
        {
          "click": "[data-testid=combo-partners-block] button[aria-expanded=false]",
          "wait": "[data-combo-lines]",
          "settle": 600
        },
        {
          "scrollTo": "[data-combo-lines]",
          "settle": 400
        }
      ]
    },
    {
      "id": "card-combo",
      "label": "card details from /decks/[id] many: a line pressed, the combo stacked on the card, back names the card",
      "view": "src/components/cards/card-combo-sheet.tsx",
      "steps": [
        {
          "goto": "/decks/${COMBOS_MANY_DECK}",
          "wait": "[data-decklist-row]",
          "settle": 1500
        },
        {
          "click": "[data-decklist-row]:has([data-testid=combo-glyph])",
          "wait": "[role=dialog]",
          "settle": 1500
        },
        {
          "scrollTo": "[data-testid=combo-partners-block]",
          "settle": 400
        },
        {
          "click": "[data-testid=combo-partners-block] button[aria-expanded=false]",
          "wait": "[data-combo-lines]",
          "settle": 600
        },
        {
          "click": "[data-combo-line] [data-combo-press] >> nth=0",
          "wait": "[data-card-combo]",
          "settle": 900
        }
      ]
    }
  ]
}
