{
  "feature": "Collection — the set filter on the phone",
  "note": "No `shares` block: the set panel is this sheet's own surface, and the wide form reaches the same filter through `FilterPanel`'s popover instead. Every row is `\"widths\": [\"phone\"]` for that reason — below 1000px the route draws a sheet and above it a row of popovers, so `Filter cards` does not exist at 1300 and clicking it there is a timeout rather than a finding. The desktop comparison is the wide bar, which `filter-chassis.json` already photographs. Steps are Playwright verbs.",
  "rows": [
    {
      "id": "filter-sheet",
      "label": "/collection — the filter sheet, Set as one row",
      "steps": [
        {
          "goto": "/collection",
          "wait": "main, [role=main], h1",
          "settle": 6000
        },
        {
          "clickRole": "button",
          "name": "^Filter cards",
          "wait": "[role=dialog]",
          "settle": 1200
        }
      ],
      "widths": [
        "phone"
      ]
    },
    {
      "id": "set-panel",
      "label": "/collection — the set panel above the sheet",
      "steps": [
        {
          "goto": "/collection",
          "wait": "main, [role=main], h1",
          "settle": 6000
        },
        {
          "clickRole": "button",
          "name": "^Filter cards",
          "wait": "[role=dialog]",
          "settle": 1200
        },
        {
          "clickRole": "button",
          "name": "^Filter by set",
          "settle": 1200
        }
      ],
      "widths": [
        "phone"
      ]
    },
    {
      "id": "set-panel-typed",
      "label": "/collection — the set panel, list narrowed",
      "steps": [
        {
          "goto": "/collection",
          "wait": "main, [role=main], h1",
          "settle": 6000
        },
        {
          "clickRole": "button",
          "name": "^Filter cards",
          "wait": "[role=dialog]",
          "settle": 1200
        },
        {
          "clickRole": "button",
          "name": "^Filter by set",
          "settle": 1000
        },
        {
          "fill": "input[aria-label='Search your sets']",
          "text": "hobbi",
          "settle": 900
        }
      ],
      "widths": [
        "phone"
      ]
    }
  ]
}
