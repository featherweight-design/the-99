      "steps": [
        {
          "goto": "/decks/${MN_ELIGIBLE}",
          "wait": "[role=tablist]",
          "settle": 1500
        },
        {
          "clickRole": "tab",
          "name": "Analysis",
          "settle": 600
        },
        {
          "wait": "[data-testid='method-notice']",
          "settle": 900,
          "scrollTo": "[data-testid='method-notice']"
        }
      ]
