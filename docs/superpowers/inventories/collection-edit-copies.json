{
  "feature": "Collection screens PR 7: Edit copies and removal (\u00a7C, \u00a7D) from the card modal on /collection",
  "clearAbout": true,
  "note": "Needs COLLECTION_EDIT_ENABLED=true and an account owning Sol Ring in several printings (the audit user on scratch-5c-choice, with C21 #263 and CMM #410 added beside the bare imports). Rows open the sheet and never press Save or Remove. The toast and Undo, \u00a7E and the saving and failed states are walked by hand, since each needs a write. The negative row (a deck's card modal) is in collection-edit-copies-negative.json.",
  "shares": {
    "module": "src/components/collection/add-cards-sheet.tsx",
    "binding": "AddCardsSheet",
    "note": "The card modal's host mounts the same sheet in edit mode; the place head mounts it in add mode."
  },
  "rows": [
    {
      "id": "modal-link-desktop",
      "label": "/collection: the card modal's receipt with Edit copies on its label line (1300)",
      "view": "src/components/collection/edit-copies-host.tsx",
      "widths": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/collection?q=Sol+Ring",
          "wait": "main, [role=main], h1",
          "settle": 6000
        },
        {
          "clickRole": "button",
          "name": "^Sol Ring",
          "wait": "[role=dialog]",
          "settle": 1500
        },
        {
          "scrollTo": "[data-testid='edit-copies-link']",
          "settle": 300
        }
      ]
    },
    {
      "id": "edit-rest-desktop",
      "label": "Edit copies: at rest, Save disabled, a line per holding (1300)",
      "view": "src/components/collection/edit-copies-host.tsx",
      "widths": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/collection?q=Sol+Ring",
          "wait": "main, [role=main], h1",
          "settle": 6000
        },
        {
          "clickRole": "button",
          "name": "^Sol Ring",
          "wait": "[role=dialog]",
          "settle": 1500
        },
        {
          "click": "[data-testid='edit-copies-link']",
          "wait": "[role=dialog]",
          "settle": 1800
        }
      ]
    },
    {
      "id": "edit-lowered-desktop",
      "label": "Edit copies: one line lowered, the note and the diff beside Save (1300)",
      "view": "src/components/collection/edit-copies-host.tsx",
      "widths": [
        "desktop"
      ],
      "steps": [
        {
          "goto": "/collection?q=Sol+Ring",
          "wait": "main, [role=main], h1",
          "settle": 6000
        },
        {
          "clickRole": "button",
          "name": "^Sol Ring",
          "wait": "[role=dialog]",
          "settle": 1500
        },
        {
          "click": "[data-testid='edit-copies-link']",
          "wait": "[role=dialog]",
          "settle": 1800
        },
        {
          "settle": 500,
          "click": "button[aria-label='Fewer']:not([disabled])"
        }
      ]
    },
    {
