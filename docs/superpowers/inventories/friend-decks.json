{
  "feature": "Friend decks (handoff design_handoff_the99_friend_decks, R2): a friend's deck read-only, friend tiles, Hidden from friends, Settings' Your decks",
  "note": "Needs SOCIAL_FRIENDS_ENABLED and FRIEND_DECKS_ENABLED on, and a friend of the audit account with decks: FRIEND_ID is their public id; FRIEND_DECK a deck with a list, FRIEND_DECK_REPEAT one whose name repeats its commander, FRIEND_DECK_EMPTY one with a commander and no cards, FRIEND_DECK_HIDDEN one hidden from friends. Built on a scratch branch by a throwaway seed, never committed. The owner's rules include drafts, since none of those decks commits. PR 4 adds the owner's rows on the audit account itself: OWN_DECK_HIDDEN is a committed deck hidden on its own, OWN_DECK_DRAFT an uncommitted one the default Settings rule hides. The picker row also needs SOCIAL_GAMES_ENABLED on, and opens the game log on OWN_DECK_DRAFT.",
  "rows": [
    {
      "id": "decks-tab",
      "label": "/friends/[publicId]/decks: a friend's tiles, the /decks tile read-only (board 5, call 6)",
      "view": "src/components/social/friend-decks-tab.tsx",
      "steps": [
        {
          "goto": "/friends/${FRIEND_ID}/decks",
          "wait": "[data-testid='friend-deck']",
          "settle": 2500
        }
      ]
    },
    {
      "id": "decks-tab-press",
      "label": "a tile's press opens the deck's page",
      "view": "src/components/social/friend-decks-tab.tsx",
      "steps": [
        {
          "goto": "/friends/${FRIEND_ID}/decks",
          "wait": "[data-testid='friend-deck']",
          "settle": 1500
        },
        {
          "clickRole": "link",
          "name": "^Thopter Factory",
          "wait": "[data-testid='friend-deck-own']",
          "settle": 2000
        }
      ]
    },
    {
      "id": "deck-page",
      "label": "/friends/[publicId]/decks/[deckId]: a friend's deck, read-only (board 1)",
      "view": "src/components/social/friend-deck-view.tsx",
      "steps": [
        {
          "goto": "/friends/${FRIEND_ID}/decks/${FRIEND_DECK}",
          "wait": "[data-testid='friend-deck-own']",
          "settle": 2500
        }
      ]
    },
    {
      "id": "deck-page-repeat",
      "label": "a deck named for its commander: the commander line drops",
      "view": "src/components/social/friend-deck-view.tsx",
      "steps": [
        {
          "goto": "/friends/${FRIEND_ID}/decks/${FRIEND_DECK_REPEAT}",
          "wait": "[data-testid='friend-deck-own']",
          "settle": 2000
        }
      ]
    },
    {
      "id": "deck-page-empty",
      "label": "an empty deck (States): the Commander and the dashed box",
      "view": "src/components/social/friend-deck-view.tsx",
      "steps": [
        {
          "goto": "/friends/${FRIEND_ID}/decks/${FRIEND_DECK_EMPTY}",
          "wait": "[data-testid='friend-deck-empty']",
          "settle": 2000
        }
      ]
    },
    {
      "id": "deck-page-hidden",
      "label": "a hidden deck's link: the app's 404 (States, gone)",
      "view": "src/app/friends/[publicId]/decks/[deckId]/page.tsx",
      "steps": [
        {
          "goto": "/friends/${FRIEND_ID}/decks/${FRIEND_DECK_HIDDEN}",
          "wait": "h1",
          "settle": 1500
        }
      ]
    },
    {
      "id": "own-decks",
      "label": "/decks: the hidden deck's glyph in its chips row, and the key",
      "view": "src/components/decks/deck-card.tsx",
      "steps": [
        {
          "goto": "/decks",
          "wait": "[data-hidden-from-friends-glyph]",
          "settle": 2500
        }
      ]
    },
    {
      "id": "own-deck-header",
      "label": "/decks/[id]: the header's Hidden from friends mark",
      "view": "src/components/decks/hidden-from-friends-mark.tsx",
