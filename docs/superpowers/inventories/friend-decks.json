          "wait": "h1",
          "settle": 2500
        }
      ]
    },
    {
      "id": "own-deck-menu",
      "label": "the deck ⋯ menu: Hidden from friends, ticked, above Delete",
      "view": "src/components/decks/deck-card-overflow.tsx",
      "steps": [
        {
          "goto": "/decks/${OWN_DECK_HIDDEN}",
