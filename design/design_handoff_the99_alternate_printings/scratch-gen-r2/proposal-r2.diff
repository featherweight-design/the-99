diff -ruN a/src/components/cards/printing-strip.tsx b/src/components/cards/printing-strip.tsx
--- a/src/components/cards/printing-strip.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/cards/printing-strip.tsx	2026-11-22 06:19:38.174709141 +0000
@@ -0,0 +1,77 @@
+"use client";
+// Alternate printings R2 (account 2, 2026-11-22): the card's printings as a row of card-shaped thumbs in the card
+// details opened from search. Selecting one shows it in place (art, Set caption, price follow); nothing is stored.
+// Phone: in the sheet's teaser under the price line, so the art above stays in view. Desktop: under the title.
+import type { BrowsePrinting } from "@/lib/collection/browse";
+import { printingKey } from "./printing-region";
+
+export type StripPrinting = BrowsePrinting & { mine?: boolean; pick?: boolean };
+
+export function PrintingStrip({
+  printings, shownKey, onSelect, cardName, paddles = false,
+}: {
+  printings: StripPrinting[];
+  /** The key of the printing on screen. */
+  shownKey: string | null;
+  onSelect: (p: StripPrinting) => void;
+  cardName: string;
+  /** Desktop: ◂ ▸ at the ends while the row overflows (a mouse wheel does not scroll sideways). */
+  paddles?: boolean;
+}) {
+  const keyOf = (p: StripPrinting) => p.scryfallId ?? printingKey(p);
+  const mine = printings.filter((p) => p.mine).length;
+  return (
+    <div role="group" aria-label={`Printings of ${cardName}`} data-testid="printing-strip">
+      <p className="m-0 mb-[8px] font-mono uppercase text-[10px] tracking-[0.14em]" style={{ color: "var(--fg-faint)" }}>
+        {printings.length} printings{mine > 0 ? ` · you own ${mine}` : ""}
+      </p>
+      <div className="relative">
+        <div className="flex gap-[8px] overflow-x-auto pb-[2px]" style={{ scrollbarWidth: "none", paddingRight: paddles ? 34 : 0 }}>
+          {printings.map((p, i) => {
+            const shown = keyOf(p) === shownKey;
+            const divider = i > 0 && printings[i - 1].mine && !p.mine;
+            return (
+              <div key={keyOf(p)} className="flex flex-none items-stretch gap-[8px]">
+                {divider ? <span aria-hidden className="w-px flex-none self-stretch my-[6px]" style={{ background: "var(--border-strong)" }} /> : null}
+                <button
+                  type="button"
+                  aria-pressed={shown}
+                  aria-label={`${p.setName ?? p.setCode}, number ${p.collectorNumber}${p.mine ? `, ${p.quantity} in your collection` : ""}${p.pick ? ", your pick" : ""}`}
+                  onClick={() => onSelect(p)}
+                  className="flex w-[48px] flex-none flex-col items-center gap-[5px] border-0 bg-transparent p-0 cursor-pointer"
+                >
+                  <span
+                    className="block w-[48px] rounded-[4px] overflow-hidden"
+                    style={{
+                      aspectRatio: "63/88",
+                      boxShadow: shown ? "0 0 0 2px var(--bg), 0 0 0 4px var(--accent)" : "0 0 0 1px var(--border-strong)",
+                      opacity: shown ? 1 : 0.82,
+                    }}
+                  >
+                    {p.imageUri ? <img src={p.imageUri} alt="" className="block h-full w-full object-cover" /> : null}
+                  </span>
+                  <span
+                    className="font-mono text-[10px] leading-none whitespace-nowrap"
+                    style={{ color: shown ? "var(--fg)" : p.mine ? "var(--accent)" : "var(--fg-muted)" }}
+                  >
+                    {p.pick ? "◆ " : ""}{p.setCode}{p.mine && !p.pick ? ` ×${p.quantity}` : ""}
+                  </span>
+                </button>
+              </div>
+            );
+          })}
+        </div>
+        {paddles ? (
+          <button
+            type="button"
+            aria-label="More printings"
+            className="absolute right-0 top-[18px] flex h-[34px] w-[30px] items-center justify-center rounded-[8px] text-[13px] cursor-pointer"
+            style={{ background: "var(--surface-raised)", border: "1px solid var(--border-strong)", color: "var(--fg)", boxShadow: "-14px 0 14px var(--surface-rail)" }}
+          >
+            ▸
+          </button>
+        ) : null}
+      </div>
+    </div>
+  );
+}
