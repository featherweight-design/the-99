+// Tokens surfacing R1 (proposal): the Tokens strategy glyph (strategy-icon.tsx), drawn as the deck's token mark.
+import { STRATEGY_GLYPHS } from "./strategy-icon";
+export function TokenGlyph({ size = 13, className = "" }: { size?: number; className?: string }) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden className={`flex-none ${className}`}>
+      {STRATEGY_GLYPHS.tokens}
+    </svg>
+  );
+}
+/** Which concept the scratch render draws: undefined is main as shipped. */
+export const tokConcept = (): undefined | "base" | "A" | "B" | "C" => (globalThis as any).__TOK;
