+}
+
+function Compose({ friend, fromThem, fromYou, side = "you", theirs = [], yours = [], picked = new Set(), state = "draft", daysLeft = 14, was, tradedDay, wanted = new Set(), alsoIn = new Map(), openOffered }: TradeSheetProps) {
