+  /** The spares sheet over a deck or All shopping (R2): Trade beside Ask, and the trade made in the sheet. */
+  sheet: {
+    press: "Trade",
+    // R4: under the friend rows, so asking stays plainly an ask.
+    how: "Ask and they give it to you. Trade to offer one of your spares for it.",
+    pressAria: (f: Name, card: string) => personText`Propose a trade with ${f} for ${card}`,
+    open: "Trade open",
