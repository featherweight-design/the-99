+            <div key={String(o.name)} className="flex items-center gap-[8px] py-[5px] [border-top:1px_solid_var(--border)] first-of-type:[border-top:0]">
+              <span className="flex min-w-0 flex-1 flex-col">
+                <b className="truncate text-[13px] font-semibold text-[color:var(--fg)]"><PersonName n={o.name} /></b>
+                <span className="font-mono text-[10.5px] text-[color:var(--fg-muted)]">{t.offeredPop.line(o.daysLeft)}</span>
+              </span>
+              <a href="#" className="flex-none text-[12.5px] font-medium text-[color:var(--accent-text)] no-underline">{t.offeredPop.open}</a>
+            </div>
+          ))}
+        </div>
+      ) : null}
+    </>
+  );
+}
