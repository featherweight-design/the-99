+          <span className="text-[12.5px] leading-[1.5] text-[color:var(--fg-body)]"><PersonText text={t.sheet.sentBody(friend)} /></span>
+        </span>
+      </div>
+      <div className="flex flex-wrap items-center gap-[10px]">
+        <PrimaryButton className={`${ACTION_SIZE} font-medium`}>{t.sheet.done}</PrimaryButton>
