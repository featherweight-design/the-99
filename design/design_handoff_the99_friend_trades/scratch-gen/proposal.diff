+  const ink = card.gone ? "text-[color:var(--warning)]" : card.change === "added" ? "text-[color:var(--accent-text)]" : card.agreed ? "text-[color:var(--success)]" : "text-[color:var(--fg-faint)]";
+  return (
+    <li className="flex w-[64px] min-w-0 flex-col gap-[5px] md:w-[78px]">
+      <span className="relative block">
+        <button type="button" aria-label={card.gone ? `${card.name}, ${t.gone}` : card.name} className={`${TILE_BOX} ${card.change === "added" ? RING : ""} ${out ? "opacity-45" : ""}`}>
+          {card.imageUri ? <HydratedImg eager src={card.imageUri} alt="" className="absolute inset-0 block h-full w-full object-cover" /> : null}
+        </button>
+        {card.gone ? (
+          <span aria-hidden title={t.gone} className="absolute right-[-6px] top-[-6px] grid h-[22px] w-[22px] place-items-center rounded-full bg-[color:color-mix(in_srgb,var(--danger)_16%,var(--bg))] text-[color:var(--danger)] [border:1px_solid_color-mix(in_srgb,var(--danger)_45%,transparent)]">
