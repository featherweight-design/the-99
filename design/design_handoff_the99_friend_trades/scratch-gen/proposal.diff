+
+/** R10: the Wants chip (half width; beside Offered, just its glyph, which the key names). */
+function MarkChip({ tone, glyph, label, full, squeeze }: { tone: "fact"; glyph: ReactNode; label: ReactNode; full: PersonParts; squeeze: boolean }) {
+  return (
+    <span className={`${CHIP} flex-1 basis-0 text-[color:var(--fact)] bg-[color-mix(in_oklab,var(--fact)_14%,transparent)]`}>
+      <span className="inline-flex flex-none">{glyph}</span>
+      <span aria-hidden className={`min-w-0 truncate `}>{label}</span>
+      <span className="sr-only"><PersonText text={full} /></span>
+    </span>
+  );
+}
+
+/** R10: Offered, a press. One name: the name. Several: the first + N on desktop, "N friends" on a phone. Opens who, and when. */
+function OfferedChip({ offered, open, solo }: { offered: readonly OfferedTo[]; open: boolean; solo: boolean }) {
+  const names = offered.map((o) => o.name);
+  return (
+    <>
+      <button type="button" aria-expanded={open} aria-haspopup="dialog" className={`${CHIP} ${MUTED} flex-1 basis-0 cursor-pointer [border:0] ${open ? "ring-1 ring-[color:var(--border-strong)]" : ""}`}>
