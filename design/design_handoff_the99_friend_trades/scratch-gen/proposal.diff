+        {names.length === 1 ? <span aria-hidden className="min-w-0 truncate"><PersonName n={names[0]} /></span> : (
+          <span aria-hidden className="min-w-0 truncate">{t.offeredCount(names.length)}</span>
+        )}
+        <span className="sr-only"><PersonText text={t.alsoOffered(names)} /></span>
+      </button>
+      {open ? (
+        <div role="dialog" aria-label={t.offeredPop.title} className={`absolute top-[28px] z-10 flex w-[232px] flex-col gap-[2px] rounded-[10px] bg-[color:var(--surface-raised,var(--surface-rail))] p-[10px] shadow-[0_10px_28px_rgba(0,0,0,.5)] [border:1px_solid_var(--border-strong)] ${solo ? "left-0" : "right-0"}`}>
