+"use client";
+// Friend trades R3/R4 (Hugh 2026-11-27): the head of a friend's Spares tab. The tiles below ask exactly as shipped (a press
+// opens the spares sheet, which offers Trade beside Ask). With live trades (several may be open with one friend; one
+// unanswered offer of yours at a time, Q10) they head the tab in the Trades row's form. R4c: under them, the Wishlist tab's
+// You have it parts, reused so the two tabs read alike: the call-out box (eyebrow + `TodoRow` statements), then the
+// compact radio `SegmentedSwitch` (All · N / You want · N) and the key line.
+import { DeckBox, DeckBoxBand, DeckBoxFoot } from "../decks/deck-box";
+import { TodoRow } from "../decks/todo-card";
+import { GhostButton, ACTION_SIZE } from "../ui/button";
+import { SegmentedSwitch } from "../ui/segmented-switch";
+import { PersonText, type ThirdPartyName } from "../../lib/person-name";
+import { haveItCopy } from "../../lib/copy/social";
+import { tradeCopy as t } from "../../lib/copy/trades";
+import { SpareGlyph, WishGlyph } from "./spare-key-item";
+import { TradeRows, type TradeRowView } from "./trade-rows";
+
+export type SparesFilter = "all" | "want";
+const c = t.callout;
+const names = (list: readonly string[]) => haveItCopy.callout.names(list);
+
+export function TradesHead({ friend, live, wants, youWant = [], capped = false, total, filter = "all" }: {
+  friend: ThirdPartyName; live: readonly TradeRowView[];
+  /** Your spares on this friend's wishlist (names). */
+  wants: readonly string[];
+  /** This friend's spares you want: on your wishlist or a deck needs them (names). */
+  youWant?: readonly string[];
+  /** Q10: an offer of yours to this friend is unanswered, so another waits (accepted trades don't count). */
+  capped?: boolean;
+  total: number;
+  filter?: SparesFilter;
+}) {
+  const propose = { label: t.sheet.press, name: t.propose, onPress: () => {} };
+  return (
+    <>
+      {live.length ? (
+        <DeckBox className="!mt-[18px] md:!mt-[22px]" data-testid="trades-head">
+          <DeckBoxBand title={<PersonText text={t.liveTitle(friend)} />} aside={<span className="font-mono text-[11px] font-normal text-[color:var(--fg-muted)]">{t.openCount(live.length)}</span>} />
+          <TradeRows rows={live} />
+          <DeckBoxFoot>
+            <div className="flex flex-col gap-[8px] md:flex-row md:items-center md:justify-end md:gap-[14px]">
+              {capped ? <span className="text-[12px] leading-[1.45] text-[color:var(--fg-muted)] md:order-first">{t.capLine(friend)}</span> : null}
+              <GhostButton disabled={capped} className={`${ACTION_SIZE} flex-none self-start font-medium md:self-auto ${capped ? "opacity-45" : ""}`}>{t.proposeAnother}</GhostButton>
+            </div>
+          </DeckBoxFoot>
+        </DeckBox>
+      ) : null}
+      <div data-testid="spares-callout" className={`${live.length ? "mt-[14px]" : "mt-[18px] md:mt-[22px]"} flex flex-col gap-[10px]`}>
+        <div className="overflow-hidden rounded-[10px] bg-[color:var(--surface-rail)] [border:1px_solid_var(--border)]">
+          <p className="m-0 px-[14px] pb-[2px] pt-[9px] font-mono text-[9.5px] uppercase tracking-[0.14em] text-[color:var(--fg-faint)] md:px-[16px]">{c.eyebrow}</p>
+          {youWant.length ? (
+            <TodoRow tone="action" next={false} mark={<WishGlyph size={14} />}
+              title={<PersonText text={c.youWantTitle(friend, youWant.length)} />} body={c.youWantBody(names(youWant))} />
+          ) : null}
+          {wants.length ? (
+            <TodoRow tone="action" markTone="fact" next={false} mark={<SpareGlyph size={16} />}
+              title={<PersonText text={c.theyWantTitle(friend, wants.length)} />} body={c.theyWantBody(names(wants))}
+              press={live.length ? undefined : propose} />
+          ) : null}
+          {!youWant.length && !wants.length ? (
+            <TodoRow tone="action" markTone="fact" next={false} mark={<SpareGlyph size={16} />} title={c.noneTitle} body={c.noneBody} press={live.length ? undefined : propose} />
+          ) : null}
+        </div>
+        <div className="flex flex-col items-start gap-[10px]">
+          {youWant.length > 0 && <SegmentedSwitch<SparesFilter> kind="radio" size="compact" ariaLabel={c.filterAria} value={filter} onChange={() => {}}
+            segments={[{ value: "all", label: c.filterAll, count: total }, { value: "want", label: c.filterWant, count: youWant.length }]} />}
+          <ul className="m-0 flex list-none flex-wrap items-center gap-x-[14px] gap-y-[4px] p-0 font-mono text-[10.5px] text-[color:var(--fg-faint)]">
+            <li className="inline-flex items-center gap-[6px]"><span className="inline-flex text-[color:var(--accent-text)]"><WishGlyph size={11} /></span>{c.keyWish}</li>
+            <li className="inline-flex items-center gap-[6px]"><i aria-hidden className="size-[7px] shrink-0 rounded-full border border-dashed border-[color:var(--fg-muted)]" />{c.keyDeck}</li>
+          </ul>
+        </div>
+      </div>
+    </>
+  );
+}
