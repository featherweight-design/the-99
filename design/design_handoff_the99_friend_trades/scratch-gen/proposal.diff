+}
+
+function Sent({ friend, fromThem, fromYou }: TradeSheetProps) {
+  return (
+    <div className="flex flex-col gap-[14px] px-[16px] pb-[24px] pt-[14px] md:px-[18px] md:pb-[20px]">
+      <div className="flex items-center gap-[14px] rounded-[10px] px-[14px] py-[14px] [border:1px_solid_color-mix(in_oklab,var(--success)_35%,var(--border))] bg-[color:color-mix(in_oklab,var(--success)_7%,var(--surface-inset))]">
