+          segments={[
+            { value: "them", label: <PersonText text={t.pick.theirs(friend)} />, count: count(picker.theirs.length) },
+            { value: "you", label: t.pick.yours, count: count(picker.yours.length) },
+          ]} />
+      </div>
+      {lines.length === 0 ? (
