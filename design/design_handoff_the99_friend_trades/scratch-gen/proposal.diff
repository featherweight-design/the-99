+"use client";
+// Friend trades R2 (Hugh 2026-11-27, item a): a trade made in the spares sheet over a deck or All shopping, so the reader
+// never leaves the deck. Trade on a friend's row pushes this body inside the same sheet (`ModalChrome`'s `back`, as
+// combos close pushes its body): the trade box as the Spares tab draws it, the card the row was for already on the
+// friend's side, then the side switch and the spares to pick from, three across in the sheet. Send offer turns the body
+// into its receipt: Done closes the sheet (the reader is where they were); Open the trade goes to the friend's Spares tab,
+// whose back link then names the deck.
+import type { ReactNode } from "react";
+import { ModalChrome } from "../decks/receipt-modal";
+import { SegmentedSwitch } from "../ui/segmented-switch";
+import { GhostButton, PrimaryButton, ACTION_SIZE } from "../ui/button";
+import { SpareGlyph } from "./spare-key-item";
+import { HydratedImg } from "../ui/hydrated-art";
+import { PersonName, PersonText, type PersonParts, type ThirdPartyName } from "../../lib/person-name";
+import { tradeCopy as t } from "../../lib/copy/trades";
+import { socialCopy } from "../../lib/copy/social";
+import { TradeTab, type TradeCard, type TradeState } from "./trade-tab";
+import type { SpareBrowseLine } from "../../lib/social/spare-browse";
+
+const TILE_BOX = "relative block w-full cursor-pointer overflow-hidden p-0 [aspect-ratio:63/88] [border-radius:4.5%/3.2%] [border:1px_solid_var(--border)] bg-[color:var(--surface-sunken)]";
+const RING = "outline-solid outline-2 outline-offset-[3px] outline-[color:var(--accent)]";
+
+export type TradeSheetProps = {
+  friend: ThirdPartyName;
+  fromThem: TradeCard[];
+  fromYou: TradeCard[];
+  side?: "them" | "you";
+  theirs?: SpareBrowseLine[];
+  yours?: SpareBrowseLine[];
+  picked?: ReadonlySet<string>;
+  sent?: boolean;
+  /** R3: the one place a trade is made AND read: any state, from a deck, a friend's Spares tab, a Trades row or a push. */
+  state?: TradeState;
+  daysLeft?: number;
+  was?: { them: number; you: number; day: string };
+  tradedDay?: string;
+  /** Opened from a friend row of the spares sheet: ← Friends' spares goes back to it. Elsewhere the sheet just closes. */
+  fromSpares?: boolean;
+  /** R3: your spares on this friend's wishlist: listed first in Your spares, each tagged. */
+  wanted?: ReadonlySet<string>;
+  /** R4b (Q9): your spares already in an open offer to someone else, by oracle id: tagged, still pickable. */
+  alsoIn?: ReadonlyMap<string, readonly OfferedTo[]>;
+  /** R10: the tile whose Offered chip is pressed open (static render). */
+  openOffered?: string;
+};
+const COMPOSING = new Set<TradeState>(["draft", "askBack", "counterDraft"]);
+
+export function TradeSheet(props: TradeSheetProps) {
+  // The sheet's head names the trade; the picker shows only while composing (a draft, Make it a trade, a counter).
+  const { friend, sent } = props;
+  return (
+    <ModalChrome title="" titleNode={<PersonText text={t.sheet.title(friend)} />} closeLabel={socialCopy.friendPage.back} onClose={() => {}} width={640}
+      back={!sent && props.fromSpares ? { label: t.sheet.back, aria: t.sheet.back, onBack: () => {} } : undefined}
+      eyebrow={sent || !props.fromSpares ? t.feed.kicker : undefined} stand={!sent && COMPOSING.has(props.state ?? "draft")} fit={sent || !COMPOSING.has(props.state ?? "draft")}>
