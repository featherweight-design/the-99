// Regenerates `src/lib/spellbook/produces-kinds.generated.ts` — the Commander Spellbook
// feature names that END A GAME, and the ones that name a TURN LOOP.
//
// Run: `pnpm build:combo-features`. Reads the ingested `spellbook_variants.produces`
// vocabulary; writes no database rows. DEVELOPER-RUN, never on a cron, and that is the whole
// point of the pattern: the committed diff is the review. A cron cannot commit, so a
// "regenerated by each ingest" list would either drift from the file or need the job to push,
// and neither is a thing anyone reviews. `tag-kinds.generated.ts` is the precedent.
//
// WHY AN ALLOWLIST FOR GAME-ENDING AND A REGEX FOR INFINITE. The `Infinite …` family grows
// between regenerations and a new member is unambiguously unbounded BY ITS OWN NAME, so
// `combo-features.ts` matches it live and misses nothing. Game-ending names share no shape
// ("Win the game", "Target opponent loses the game"), so they are enumerated here and an
// unrecognised one defaults to NOT game-ending — under-claiming, which is the safe direction
// for a rule that pushes a deck UP a bracket.
//
// First, and on its own line: src/db reads DATABASE_URL at module scope.
import { requireEnv } from "./lib/env.mjs";
requireEnv(["DATABASE_URL"]);
import { writeFileSync } from "node:fs";
import { sql } from "drizzle-orm";
import { db } from "../src/db";

const OUT = new URL("../src/lib/spellbook/produces-kinds.generated.ts", import.meta.url);

/**
 * Ends a game outright, by its own wording.
 *
 * The NEGATED forms are excluded, and the first generation is what found them: a bare
 * `/loses? the game/` matched "You are unable to lose the game due to damage or lifeloss" and
 * "You can't lose the game due to having 0 or less life", which are DEFENSIVE effects — the
 * exact opposite of a win condition, and both would have pushed a deck up a bracket for
 * surviving. This is what the committed vocabulary snapshot is for: a human reads the
 * classified list before it ships, and these two were visible on the first read.
 */
const GAME_ENDING =
  /(?<!\b(?:unable to|can'?t|cannot|don'?t|doesn'?t|never)\s)\b(?:wins?|loses?) the game\b/i;
/** Names a turn loop — the measurable half of WotC's "chained or looped" clause. */
const INFINITE_TURNS = /^infinite (extra )?turns?\b/i;
/** The family matched live at runtime; listed here only so the snapshot shows its size. */
const INFINITE = /^infinite /i;

const rows = await db.execute<{ name: string; n: number }>(sql`
  select f as name, count(*)::int as n
  from ${sql.raw("spellbook_variants")}, unnest(produces) as f
  group by f order by count(*) desc, f
`);
const vocabulary = (rows as unknown as { rows?: { name: string; n: number }[] }).rows ?? rows;
const all = vocabulary as { name: string; n: number }[];

if (all.length === 0) {
  console.error(
    "build-combo-features: `spellbook_variants` is empty — run `pnpm db:seed:combos` first.\n" +
      "Generating from nothing would commit an empty allowlist and silently stop classifying\n" +
      "every game-ending combo.",
  );
  process.exit(1);
}

const gameEnding = all.filter((f) => GAME_ENDING.test(f.name)).map((f) => f.name).sort();
const infiniteTurns = all.filter((f) => INFINITE_TURNS.test(f.name)).map((f) => f.name).sort();
const infinite = all.filter((f) => INFINITE.test(f.name));

const body = `// GENERATED by \`pnpm build:combo-features\` — do not edit by hand.
//
// Commander Spellbook feature names, classified for the bracket slot. Developer-run: the
// committed diff is the review. See scripts/build-combo-features.mts for why game-ending is
// an allowlist while the \`Infinite …\` family is matched live.
//
// Vocabulary at generation: ${all.length} distinct feature names across the ingested variants
//   game-ending ${gameEnding.length} · infinite-turns ${infiniteTurns.length} · \`Infinite …\` family ${infinite.length}

/** Ends a game outright. An unrecognised name is NOT game-ending — under-claiming. */
export const GAME_ENDING_FEATURES: readonly string[] = [
${gameEnding.map((f) => `  ${JSON.stringify(f)},`).join("\n")}
];

/** Names a turn loop. WotC's B2/B3 clause forbids extra turns "chained or looped". */
export const INFINITE_TURN_FEATURES: readonly string[] = [
${infiniteTurns.map((f) => `  ${JSON.stringify(f)},`).join("\n")}
];

/** The whole vocabulary at generation, with counts — so a reader can audit what was
    classified and what was not, and so an upstream change shows up here as a diff. */
export const VOCABULARY_SNAPSHOT: readonly { name: string; variants: number }[] = [
${all.map((f) => `  { name: ${JSON.stringify(f.name)}, variants: ${f.n} },`).join("\n")}
];
`;

writeFileSync(OUT, body);
console.log(
  `combo-features: ${all.length} distinct names — ${gameEnding.length} game-ending, ` +
    `${infiniteTurns.length} infinite-turns, ${infinite.length} in the Infinite family`,
);
console.log(`wrote ${OUT.pathname}`);
process.exit(0);
