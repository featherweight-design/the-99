import { MARK_NUMERAL_DISC, SLUG } from "../../src/lib/bracket/mark-size";

/**
 * What the bracket-mark copy IS, with no side effects, so a test can import it.
 *
 * `copy-bracket-marks.mts` does the copying and runs on import — a test importing that would
 * rewrite `public/` as a side effect of asserting. The facts the copy is built from live here
 * instead, which is also what lets the test compare a stripped SOURCE against the committed
 * TARGET rather than only inspecting the target and calling it proof.
 */
export const SOURCE = "design/design_handoff_the99_deck_analysis/assets";
export const TARGET = "public/brackets";

/**
 * The ten the mark set defines, DERIVED FROM `markAsset`'s own table rather than spelled again.
 *
 * `mark-size.ts` already says a slug is never spelled at a call site. A second copy here is
 * exactly the drift that warns about: a rename there would leave the copier succeeding over the
 * old filenames while the renderer asks for the new ones — a silent 404 at the draw, behind a
 * green `assets:brackets`.
 */
export const EXPECTED = Object.values(SLUG).flatMap((slug) => [
  `${slug}.svg`,
  `${slug}-chip.svg`,
]);

/**
 * The manifest only. Nothing else in these files is removed — the `xmlns:c2pa` attribute stays,
 * because rewriting the root element is a bigger promise than this step should make.
 */
export function strip(svg: string): string {
  return svg.replace(/<metadata>[\s\S]*?<\/metadata>/g, "").replace(/\n{2,}/g, "\n");
}

/** The stylesheet the marks are drawn from (`BracketMark`), generated from the files above. */
export const CSS_TARGET = "src/app/bracket-marks.css";

/**
 * Every mark's art as a data URI inside a stylesheet, so the mask is resolved with the CSS, before
 * first paint. A mask fetched by url paints its other layer alone until the file lands: the full
 * form's numeral disc then draws as a filled square, which is what a cold load showed (Hugh,
 * 2026-10-11). The files in `public/` stay the source; this is their build, pinned by a test.
 */
/** An SVG as a CSS data URI, encoded as little as is safe: single quotes inside, and only the
 *  characters a url() or a data URI cannot carry escaped. */
function svgUrl(svg: string): string {
  const min = svg
    .replace(/\s+xmlns:c2pa="[^"]*"/, "")
    .replace(/\s*\n\s*/g, " ")
    .replace(/>\s+</g, "><")
    .trim()
    .replace(/"/g, "'")
    .replace(/[%#<>]/g, (c) => encodeURIComponent(c));
  return `url("data:image/svg+xml,${min}")`;
}

export function bracketMarksCss(read: (file: string) => string): string {
  const rules = EXPECTED.map((file) => {
    const key = file.slice(0, -".svg".length);
    const full = !key.endsWith("-chip");
    return `.bracket-art[data-art="${key}"] { --bracket-art: ${svgUrl(read(file))}${full ? `, ${MARK_NUMERAL_DISC}` : ""}; }`;
  });
  return [
    "/* GENERATED by `pnpm assets:brackets` from public/brackets/. Do not edit: copy-bracket-marks.test.mts",
    "   fails when this is not the build of the committed files. */",
    ".bracket-art {",
    "  -webkit-mask-image: var(--bracket-art);",
    "  mask-image: var(--bracket-art);",
    "  -webkit-mask-repeat: no-repeat;",
    "  mask-repeat: no-repeat;",
    "  -webkit-mask-position: center;",
    "  mask-position: center;",
    "  -webkit-mask-size: contain;",
    "  mask-size: contain;",
    "}",
    "/* The full form subtracts its file's own numeral: art and disc, intersected. */",
    '.bracket-art[data-form="full"] {',
    "  -webkit-mask-size: contain, 100% 100%;",
    "  mask-size: contain, 100% 100%;",
    "  -webkit-mask-composite: source-in;",
    "  mask-composite: intersect;",
    "}",
    ...rules,
    "",
  ].join("\n");
}
