// pnpm build:creature-types: writes `src/lib/strategy/creature-types.generated.ts`, Scryfall's creature-type catalog,
// the vocabulary the strategy axes read a typal axis against (`axes.ts`). A type line's subtypes are not all creature
// types (`Artifact Creature — Equipment Cat`, `Tribal Enchantment — Faerie Aura`) and some creature types are two words
// (`Time Lord`), so splitting on spaces alone misreads both. Developer-run, like `build:tag-kinds`; the diff is the review.
import { writeFileSync } from "node:fs";

const OUT = new URL("../src/lib/strategy/creature-types.generated.ts", import.meta.url);
const URL_ = "https://api.scryfall.com/catalog/creature-types";
/** Scryfall's catalog held 300+ types when this was written; a payload far under that is a broken upstream, not a change. */
const FLOOR = 250;

const res = await fetch(URL_, { headers: { Accept: "application/json", "User-Agent": "the-99/creature-types" } });
if (!res.ok) throw new Error(`${URL_} -> HTTP ${res.status}`);
const body = (await res.json()) as { object?: string; data?: unknown };
if (body.object !== "catalog" || !Array.isArray(body.data) || !body.data.every((t) => typeof t === "string")) {
  throw new Error(`${URL_} -> not a catalog payload`);
}
const types = [...new Set(body.data as string[])].sort((a, b) => a.localeCompare(b));
if (types.length < FLOOR) throw new Error(`${URL_} -> ${types.length} types, under the floor of ${FLOOR}`);

writeFileSync(OUT, [
  "// GENERATED by `pnpm build:creature-types` from Scryfall's creature-type catalog. Do not edit by hand.",
  `// ${types.length} types.`,
  "",
  "export const CREATURE_TYPES: readonly string[] = [",
  ...types.map((t) => `  ${JSON.stringify(t)},`),
  "];",
  "",
].join("\n"));
console.log(`wrote ${types.length} creature types`);
