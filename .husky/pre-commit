# No commits on main: work happens on a branch in a worktree under .worktrees/<branch>.
branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$branch" = "main" ]; then
  echo "Direct commits to main are not allowed. Create a feature branch (in a worktree) first."
  exit 1
fi

# No backup stash: it lives on the repo-global stash stack that every worktree shares (a concurrent session's push moves
# its index), so a commit stages whole files, which is how work is committed here anyway (stage files by name).
node_modules/.bin/lint-staged --no-stash
